node_modules/
dist/
.astro/
.wrangler/
.env
.DS_Store
.claude/worktrees/

# Generado por npm run data:fetch / data:mock (docs/06-roadmap.md#H5). Se
# regenera en cada build, incluido en CI antes de desplegar (RF-01/RF-02): no
# tiene sentido llevar en el historial de git un scrape del ministerio que
# cambia cada dos horas. Ejecuta uno de los dos comandos antes de `npm run dev`.
public/data/indice.json
public/data/provincias/*.json
public/data/resumen-nacional.json
public/data/historico/

# 71 reglas de redirección 301 (RF-96, ADR-0018), generadas por el mismo
# npm run data:fetch / data:mock a partir del catálogo de zonas: se genera,
# nunca se escribe a mano, así que tampoco se lleva en el historial.
public/_redirects

# Catálogo de municipios (H10, segunda mitad): solo lo lee el build
# (getStaticPaths, sitemap.xml.ts), nunca el navegador. Deliberadamente
# fuera de public/ para que no se despliegue ni se pueda pedir por fetch —
# ver IndiceMunicipios en scripts/lib/tipos.ts.
datos-build/

# Ventana histórica normalizada de trabajo (V2-01). Se reconstruye desde el
# histórico oficial o desde el artefacto del despliegue anterior; nunca se
# versionan sus ~100 MB de JSON diarios compactados en el repositorio.
datos-historicos/

# Imágenes de compartición (RF-66, H11, ver ADR-0011): 1160 PNG generados por
# scripts/generar-imagenes-compartir.ts a partir de los precios del momento.
# Se regeneran en cada build igual que public/data/; llevarlos en el
# historial de git sería ~35 MB de binarios repetidos cada dos horas.
public/og/

# Frames de referencia visual (~15.000 líneas de JSON), derivados
# mecánicamente de design-reference/surtidor.pen por extract-design.py. La
# fuente se versiona; su extracción no — ver design-reference/CODEX.md para
# el comando de regeneración.
design-reference/frames/
design-reference/manifest.json
