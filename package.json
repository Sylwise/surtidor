{
  "name": "surtidor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run comprobar:datos && npm run generar:imagenes && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p scripts/tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types scripts/**/*.test.ts src/**/*.test.ts",
    "comprobar:menu-hoy": "node --experimental-strip-types scripts/comprobar-menu-hoy-build.ts",
    "data:fetch": "node --experimental-strip-types scripts/descargar-datos.ts",
    "materializar:historico": "node --experimental-strip-types scripts/materializar-historico.ts",
    "preparar:historico": "node --experimental-strip-types scripts/preparar-historico.ts",
    "data:mock": "node --experimental-strip-types scripts/datos-mock.ts",
    "comprobar:datos": "node --experimental-strip-types scripts/comprobar-datos-reales.ts",
    "generar:imagenes": "node --experimental-strip-types scripts/generar-imagenes-compartir.ts",
    "deploy": "wrangler pages deploy dist/ --project-name=surtidor"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.6",
    "maplibre-gl": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0",
    "wrangler": "^4.118.0"
  }
}
