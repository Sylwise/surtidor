---
// H10 · El cascarón interactivo (cabecera, hoja, mapa, lista, tótem) que
// comparten src/pages/[zona]/index.astro y
// src/pages/[provincia]/[municipio]/index.astro (segunda mitad de H10): la
// misma aplicación de siempre, con la zona activa fijada desde un prop en
// vez de localStorage, para que cada página estática enseñe siempre la zona
// que prometen su <title> y su URL.
//
// Extraído de [zona]/index.astro para no duplicar ~400 líneas de
// orquestación entre las dos páginas: cualquier cambio de comportamiento se
// hace aquí una vez. El <html>/<head>/<body>, el <title> y la tabla estática
// de SEO son cosa de cada página, no de este componente.
//
// `hidratacionEmbebida` la decide quien llama, no este componente:
// - La página de zona la calcula por tamaño (UMBRAL_HIDRATACION_EMBEBIDA,
//   ver el porqué en src/logica/zona.ts).
// - La página de municipio la fuerza siempre a `false`: su widget
//   interactivo muestra la PROVINCIA entera (no hay "zona" de un solo
//   municipio en el modelo de datos), y esa provincia la comparten todas las
//   páginas de sus municipios más su propia página de zona. Si cada una
//   embebiera los mismos datos, se repetirían una vez por página sin caché;
//   con fetch, el navegador y el CDN reaprovechan el mismo
//   /data/provincias/NN.json entre todas.
import marcaSvg from '../assets/marca.svg?raw';
import type { EstacionZona } from '../logica/zona.ts';

interface Props {
  zonaId: string;
  zonaNombre: string;
  /** Si `true`, `estaciones`/`mock`/`actualizado` van embebidos en el HTML
   *  para que el cliente arranque sin red. Si `false`, esos tres props se
   *  ignoran y el cliente los pide por fetch, como antes de H10. */
  hidratacionEmbebida: boolean;
  estaciones?: EstacionZona[];
  mock?: boolean;
  actualizado?: string | null;
  /** RF-88 (ADR-0016): en una página de zona, elegir otra zona no recarga —
   *  se cambia en sitio y `#tabla-zona` se regenera. En una página de
   *  municipio (`false`), elegir zona sigue siendo una navegación completa:
   *  es otro tipo de página, con su `<h1>` y su JSON-LD propios, que este
   *  componente no sabe regenerar. */
  esPaginaDeZona: boolean;
}

const {
  zonaId,
  zonaNombre,
  hidratacionEmbebida,
  estaciones = [],
  mock = false,
  actualizado = null,
  esPaginaDeZona,
} = Astro.props;

const datosHidratacion = hidratacionEmbebida
  ? JSON.stringify({ estaciones, mock, actualizado }).replace(/</g, '\\u003c')
  : '';
---

<div class="app" id="app" data-zona-id={zonaId} data-zona-nombre={zonaNombre} data-es-pagina-de-zona={String(esPaginaDeZona)}>
  <header class="cabecera">
    <span class="marca">
      <span class="marca__icono" aria-hidden="true" set:html={marcaSvg} />
      <span class="marca__texto">Surtidor</span>
    </span>
    <div id="controles-identidad" class="controles-identidad" aria-label="Zona"></div>
    <span id="insignia-mock" class="insignia-mock" hidden>Datos de prueba</span>
  </header>

  <div id="avisos" class="avisos" role="status" aria-live="polite"></div>

  <div class="layout">
    <aside class="hoja" id="hoja" data-estado="media">
      <button type="button" class="hoja__asa" id="hoja-asa" aria-label="Panel de estaciones. Flecha arriba o abajo para cambiar de tamaño."></button>
      <div id="controles-rapidos" class="hoja__rapidos" aria-label="Combustible"></div>
      <div class="hoja__cuerpo">
        <section id="totem" class="totem" aria-label="Ficha de la estación seleccionada"></section>
        <section id="lista" class="lista" aria-label="Lista de estaciones"></section>
      </div>
    </aside>

    <div id="mapa" class="mapa-hueco">
      <p>Cargando mapa…</p>
    </div>
  </div>
</div>

{hidratacionEmbebida && (
  <script type="application/json" id="datos-zona" is:inline set:html={datosHidratacion} />
)}

<script>
  // Orquestación de la aplicación interactiva. La zona activa se fija a la
  // que declara #app (data-zona-id/data-zona-nombre) antes de cargar nada,
  // para que la página siempre enseñe la zona que prometen su <title> y su
  // URL — a diferencia de src/pages/index.astro, que elige la zona guardada
  // en localStorage o, si no hay ninguna, abre el selector.
  //
  // RF-88 (ADR-0016): en una página de zona (data-es-pagina-de-zona="true"),
  // elegir otra zona en el selector ya NO recarga el documento. Antes sí,
  // porque el <title> y la <meta description> servidos llevan el nombre de
  // la zona y su precio mínimo, y un cambio en sitio los habría dejado
  // describiendo otra zona. El motivo por el que eso ya no aplica —quien lee
  // esas etiquetas nunca está en la pestaña del usuario— está en ADR-0016;
  // aquí solo cambia la mecánica: `cambiarZona`, más abajo, carga la zona
  // nueva y actualiza mapa, lista, `#tabla-zona`, título y dirección a la
  // vez, o no toca nada si falla. En una página de municipio
  // (data-es-pagina-de-zona="false") el comportamiento de antes se queda
  // igual: es otro tipo de página, con su propio <h1> y JSON-LD, que este
  // componente no sabe regenerar.
  //
  // El botón atrás/adelante (`popstate`) también entra por `cambiarZona`,
  // más abajo: la dirección es la fuente de verdad, no `zonaMostrada` ni
  // `estado.zonaId`.
  import { actualizarEstado, obtenerEstado, suscribir, type EstadoApp } from '../logica/estado.ts';
  import {
    cargarIndice,
    cargarZona,
    zonaDeReserva,
    provinciaMasCercana,
    type EstacionZona,
    type FalloProvincia,
  } from '../logica/zona.ts';
  import { montarControles } from './Controles.ts';
  import { montarLista } from './Lista.ts';
  import { montarTotem } from './Totem.ts';
  import { montarHoja } from './Hoja.ts';
  import { renderizarTablaZona } from './TablaZona.ts';
  import { datosDesactualizados } from '../logica/frescura.ts';
  import { formatearFechaHora } from '../logica/formato.ts';
  import { tituloZona, descripcionZona } from '../logica/metaZona.ts';
  import type { Indice } from '../../scripts/lib/tipos.ts';

  function elemento(id: string): HTMLElement {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Falta el elemento #${id} en el HTML de la página.`);
    return el;
  }

  const contenedorApp = elemento('app');
  const contenedorCabecera = document.querySelector('.cabecera') as HTMLElement;
  const contenedorControlesIdentidad = elemento('controles-identidad');
  const contenedorControlesRapidos = elemento('controles-rapidos');
  const contenedorTotem = elemento('totem');
  const contenedorLista = elemento('lista');
  const contenedorMapa = elemento('mapa');
  const contenedorAvisos = elemento('avisos');
  const insigniaMock = elemento('insignia-mock');
  const hoja = elemento('hoja');
  const asaHoja = elemento('hoja-asa') as HTMLButtonElement;
  // Solo existe en páginas de zona (src/pages/[zona]/index.astro le pone el
  // id): en páginas de municipio es `null` y no se usa, porque ahí
  // `esPaginaDeZona` es `false` y `cambiarZona` nunca se llama.
  const contenedorTablaZona = document.getElementById('tabla-zona');

  // El mapa en móvil es `position: fixed` bajo la cabecera (ADR-0006) y
  // necesita saber su alto real.
  const actualizarAlturaCabecera = (): void => {
    document.documentElement.style.setProperty('--cabecera-alto', `${contenedorCabecera.offsetHeight}px`);
  };
  new ResizeObserver(actualizarAlturaCabecera).observe(contenedorCabecera);
  actualizarAlturaCabecera();

  montarHoja(hoja, asaHoja, contenedorMapa);

  // RF-43: dato derivado local a la página, fuera del estado global.
  let actualizadoZona: string | null = null;

  // Zona que promete esta página, tal y como la fijó el build.
  const zonaDeLaPagina = contenedorApp.dataset.zonaId;
  const nombreDeLaPagina = contenedorApp.dataset.zonaNombre;
  if (!zonaDeLaPagina || !nombreDeLaPagina) throw new Error('Falta la zona de la página en el HTML.');
  const esPaginaDeZona = contenedorApp.dataset.esPaginaDeZona === 'true';

  // Zona realmente mostrada ahora mismo (mapa, lista, #tabla-zona, <title>).
  // Arranca igual que `zonaDeLaPagina` y solo se mueve cuando
  // `cambiarZona`, más abajo, termina con éxito — nunca antes, y
  // nunca si falla. Es la referencia contra la que se compara `estado.zonaId`
  // en la suscripción de más abajo: no `zonaDeLaPagina`, que se queda fija
  // aunque el usuario encadene varios cambios de zona en la misma visita.
  let zonaMostrada = zonaDeLaPagina;

  // Historial (RF-88, segunda parte): la dirección manda, no lo que la
  // aplicación cree tener en memoria. Solo se toca en páginas de zona —en
  // una de municipio, elegir zona sigue siendo una navegación completa
  // (más abajo), y no hay ningún `pushState` propio del que un `popstate`
  // pueda tener que volver.
  //
  // `scrollRestoration` se fija a 'manual' en vez de dejar el valor por
  // defecto del navegador ('auto'): 'auto' restaura la posición en PÍXELES
  // de cuando se dejó esa entrada, pero el contenido bajo esos píxeles ha
  // cambiado de zona (otra tabla, otra lista de municipios), así que "el
  // mismo sitio en pantalla" ya no significa nada — el usuario puede
  // aparecer en mitad de las tablas del pie de una zona que no es la que
  // dejó ahí. Arriba del todo es el único punto que tiene sentido tras
  // cambiar de zona, así que `cambiarZona`, más abajo, sube el scroll a
  // mano cuando el cambio viene de un `popstate`.
  if (esPaginaDeZona) {
    history.scrollRestoration = 'manual';
    // Asocia la zona de esta carga a la entrada YA existente del
    // historial, sin añadir ninguna ni tocar la dirección: si no, la
    // primera vez que el usuario llega hasta aquí retrocediendo no habría
    // nada que la distinga de una entrada ajena a esta aplicación.
    history.replaceState(null, '', location.href);
  }

  // Qué reintenta el botón "Reintentar" de abajo: por defecto, recargar la
  // zona de esta página por fetch (comportamiento de siempre). Mientras
  // `cambiarZona` tiene un intento fallido pendiente, apunta a
  // reintentar ESA zona en concreto — si apuntara siempre a
  // `cargarZonaPorFetch`, "Reintentar" tras un cambio de zona fallido
  // recargaría la zona vieja en vez de tantear otra vez la que el usuario
  // pidió.
  let alReintentar: () => void = () => cargarZonaPorFetch();

  function crearAviso(
    texto: string,
    tipo: 'error' | 'parcial' | 'desactualizado',
    conReintentar: boolean
  ): HTMLDivElement {
    const div = document.createElement('div');
    div.className = `aviso aviso--${tipo}`;
    div.append(document.createTextNode(texto));
    if (conReintentar) {
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.textContent = 'Reintentar';
      boton.addEventListener('click', () => alReintentar());
      div.append(boton);
    }
    return div;
  }

  // RF-36 (fallo parcial de provincia) y el aviso de error con
  // "Reintentar" solo son alcanzables en la ruta de fetch: con los datos
  // embebidos no hay red de por medio que pueda fallar. En la ruta embebida
  // estas dos ramas simplemente nunca se disparan.
  function renderAvisos(estado: EstadoApp): void {
    contenedorAvisos.innerHTML = '';
    insigniaMock.hidden = !estado.mock;

    if (estado.error) {
      contenedorAvisos.append(crearAviso(estado.error, 'error', true));
      return;
    }
    if (estado.provinciasFallidas.length > 0) {
      const nombres = estado.provinciasFallidas.map((p: FalloProvincia) => p.nombre).join(', ');
      contenedorAvisos.append(
        crearAviso(
          `No se han podido cargar estos datos: ${nombres}. Se muestra el resto de la zona.`,
          'parcial',
          true
        )
      );
    }
    if (actualizadoZona && datosDesactualizados(actualizadoZona, new Date())) {
      contenedorAvisos.append(
        crearAviso(`Datos de las ${formatearFechaHora(actualizadoZona)}. Pueden estar desactualizados.`, 'desactualizado', false)
      );
    }
  }

  let indice: Indice | null = null;
  let controlesMontados = false;

  // Índice compartido por dos consumidores: el selector de zona (RF-32,
  // siempre por red, el catálogo de las 71 zonas nunca va embebido) y,
  // cuando no hay hidratación embebida, la ruta de fetch de más abajo
  // (necesita `zona.provincias` para saber qué ficheros pedir). Se pide una
  // sola vez y se reutiliza.
  async function obtenerIndiceYControles(): Promise<Indice> {
    if (!indice) {
      indice = await cargarIndice();
    }
    if (!controlesMontados) {
      montarControles(contenedorControlesIdentidad, contenedorControlesRapidos, indice.zonas);
      controlesMontados = true;
      actualizarAlturaCabecera();
    }
    return indice;
  }

  // Monta solo el selector de zona, sin tocar los datos de la zona activa
  // (que ya están en pantalla, vía el bloque embebido). Un fallo aquí no
  // toca precios ni lista (regla dura 2 de CLAUDE.md extendida al
  // selector): solo deja el selector sin montar, con su propio botón de
  // reintentar.
  async function montarSelectorZona(): Promise<void> {
    try {
      await obtenerIndiceYControles();
    } catch {
      contenedorControlesIdentidad.innerHTML = '';
      const aviso = document.createElement('span');
      aviso.textContent = 'Selector de zona no disponible. ';
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.textContent = 'Reintentar';
      boton.addEventListener('click', () => montarSelectorZona());
      aviso.append(boton);
      contenedorControlesIdentidad.append(aviso);
    }
  }

  // Ruta de fetch: para las zonas sin hidratación embebida (zonas grandes,
  // o cualquier página de municipio, ver el comentario del frontmatter) y
  // para el botón de "Reintentar" de los avisos. RF-36: un fallo de
  // provincia no tumba las demás.
  async function cargarZonaPorFetch(): Promise<void> {
    actualizarEstado({ cargando: true, error: null });
    try {
      const indiceActual = await obtenerIndiceYControles();

      // Red de seguridad: si la zona de esta página ya no existe en el
      // índice (los datos se regeneran cada dos horas), cae a la zona de
      // reserva (src/logica/zona.ts, no una elección editorial).
      const zona = indiceActual.zonas.find((z) => z.id === obtenerEstado().zonaId) ?? zonaDeReserva(indiceActual);
      if (zona.id !== obtenerEstado().zonaId) actualizarEstado({ zonaId: zona.id });

      const resultado = await cargarZona(zona, indiceActual.provincias);
      actualizadoZona = resultado.actualizado;

      actualizarEstado({
        zonaNombre: zona.nombre,
        estaciones: resultado.estaciones,
        provinciasFallidas: resultado.provinciasFallidas,
        mock: resultado.mock,
        cargando: false,
        error:
          resultado.estaciones.length === 0 && resultado.provinciasFallidas.length > 0
            ? `No se ha podido cargar ninguna provincia de ${zona.nombre}.`
            : null,
      });
    } catch (error) {
      actualizadoZona = null;
      actualizarEstado({
        cargando: false,
        error: error instanceof Error ? error.message : 'No se han podido cargar los datos.',
      });
    }
  }

  // RF-88 (ADR-0016 + historial): solo en páginas de zona. Carga la zona
  // `nuevaZonaId` (RF-36: fallo parcial incluido) y, si sale bien, actualiza
  // mapa, lista, `#tabla-zona`, <title> y <meta description> siempre; la
  // dirección solo si `actualizarHistorial` es `true`.
  //
  // `actualizarHistorial` separa las dos formas de llegar aquí POR
  // CONSTRUCCIÓN —cada llamada declara cuál es, no una bandera mutable que
  // haya que limpiar después—:
  // - `true`: el usuario acaba de elegir zona en el selector. La dirección
  //   todavía apunta a la zona vieja: hay que empujarla con
  //   `history.pushState` (nunca `location.href`, para no reconstruir el
  //   mapa).
  // - `false`: viene de un `popstate`, más abajo. El navegador YA cambió la
  //   dirección antes de disparar el evento. Volver a empujarla aquí sería
  //   el fallo clásico de añadir una entrada nueva en mitad de un
  //   retroceso, que deja el botón atrás sin poder salir.
  //
  // Si falla, las dos rutas también se separan. Con `true`, la dirección no
  // ha cambiado: se revierte `zonaId` a `zonaMostrada` y se enseña el error
  // en sitio con "Reintentar" (regla del precio del cartel: media pantalla
  // actualizada es peor que ninguna). Con `false`, la dirección YA muestra
  // la zona nueva aunque la carga haya fallado: intentar recuperarse en
  // sitio dejaría la interfaz a medias, así que se navega de verdad con
  // `location.href` — sirve el HTML estático correcto sin depender de que
  // nada más del cliente funcione.
  //
  // `zonaSolicitada` hace doble servicio:
  // 1) Descarta resultados atrasados si el usuario encadena varios cambios
  //    de zona antes de que el primero termine (clics o `popstate`, da
  //    igual el origen): solo se aplica el resultado de la ÚLTIMA zona
  //    pedida.
  // 2) Corta la reentrada: el `actualizarEstado({ cargando: true })` de
  //    aquí abajo notifica a la suscripción de más abajo SÍNCRONAMENTE, y
  //    hasta que este intento termina `zonaMostrada` todavía no se ha
  //    movido — sin este cortafuegos, esa misma notificación vuelve a ver
  //    `estado.zonaId !== zonaMostrada` y llama otra vez a `cambiarZona` con
  //    la misma zona, sin fin (se comprobó a mano: sin la guarda, la
  //    pestaña entera cuelga).
  let zonaSolicitada: string | null = null;

  async function cambiarZona(nuevaZonaId: string, actualizarHistorial: boolean): Promise<void> {
    if (nuevaZonaId === zonaMostrada || nuevaZonaId === zonaSolicitada) return;
    zonaSolicitada = nuevaZonaId;
    if (actualizarHistorial) alReintentar = () => cambiarZona(nuevaZonaId, true);
    actualizarEstado({ cargando: true, error: null });
    try {
      const indiceActual = await obtenerIndiceYControles();
      const zona = indiceActual.zonas.find((z) => z.id === nuevaZonaId);
      if (!zona) throw new Error(`La zona «${nuevaZonaId}» ya no está disponible.`);

      const resultado = await cargarZona(zona, indiceActual.provincias);
      if (resultado.estaciones.length === 0 && resultado.provinciasFallidas.length > 0) {
        throw new Error(`No se ha podido cargar ninguna provincia de ${zona.nombre}.`);
      }
      if (zonaSolicitada !== nuevaZonaId) return; // una elección más reciente ha tomado el relevo

      alReintentar = () => cargarZonaPorFetch();
      zonaMostrada = zona.id;
      actualizadoZona = resultado.actualizado;
      if (contenedorTablaZona) {
        renderizarTablaZona(contenedorTablaZona, zona.nombre, resultado.estaciones, resultado.actualizado);
      }
      document.title = tituloZona(zona.nombre);
      document.querySelector('meta[name="description"]')?.setAttribute('content', descripcionZona(zona.nombre));
      if (actualizarHistorial) {
        history.pushState(null, '', `/${zona.id}/`);
      } else {
        window.scrollTo(0, 0);
      }

      const estacionActual = obtenerEstado().estacionId;
      actualizarEstado({
        zonaId: zona.id,
        zonaNombre: zona.nombre,
        estaciones: resultado.estaciones,
        provinciasFallidas: resultado.provinciasFallidas,
        mock: resultado.mock,
        cargando: false,
        error: null,
        estacionId: resultado.estaciones.some((e) => e.id === estacionActual) ? estacionActual : null,
      });
    } catch (error) {
      if (zonaSolicitada !== nuevaZonaId) return;
      // Libera la guarda de reentrada ANTES de tocar el estado o navegar:
      // si no, un "Reintentar" (ruta `true`) pediría otra vez esta misma
      // `nuevaZonaId` y el primer `if` de arriba la descartaría por creerla
      // ya en marcha.
      zonaSolicitada = null;
      if (actualizarHistorial) {
        actualizarEstado({
          zonaId: zonaMostrada,
          cargando: false,
          error: error instanceof Error ? error.message : 'No se han podido cargar los datos de esa zona.',
        });
      } else {
        location.href = `/${nuevaZonaId}/`;
      }
    }
  }

  // Deduce la zona a mostrar de la dirección actual, no de `zonaMostrada`
  // ni de `estado.zonaId`: es la regla de fondo de esta parte de RF-88.
  function zonaIdDeDireccion(): string | null {
    return location.pathname.split('/').filter(Boolean)[0] ?? null;
  }

  if (esPaginaDeZona) {
    // No hay `pushState` aquí, nunca: la dirección la cambió el navegador
    // antes de disparar el evento, y este listener solo la sigue.
    window.addEventListener('popstate', () => {
      const nuevaZonaId = zonaIdDeDireccion();
      if (!nuevaZonaId) return;
      cambiarZona(nuevaZonaId, false);
    });
  }

  const datosZonaEl = document.getElementById('datos-zona');

  if (datosZonaEl) {
    // Hidratación embebida: el HTML ya trae la zona fusionada, así que el
    // estado se rellena con esto en vez de pedirlo por red.
    const datosZona = JSON.parse(datosZonaEl.textContent ?? 'null') as {
      estaciones: EstacionZona[];
      mock: boolean;
      actualizado: string | null;
    } | null;
    if (!datosZona) throw new Error('El bloque de datos de la zona embebido en el HTML está vacío.');

    actualizadoZona = datosZona.actualizado;
    actualizarEstado({
      zonaId: zonaDeLaPagina,
      zonaNombre: nombreDeLaPagina,
      estaciones: datosZona.estaciones,
      provinciasFallidas: [],
      mock: datosZona.mock,
      cargando: false,
      error: null,
    });
    montarSelectorZona();
  } else {
    // Sin hidratación embebida: hay que pedirla por red, con el mismo
    // temporizador de rescate que cualquier estado de carga (regla dura 1
    // de CLAUDE.md).
    actualizarEstado({ zonaId: zonaDeLaPagina, zonaNombre: nombreDeLaPagina });
    cargarZonaPorFetch();
    setTimeout(() => {
      if (obtenerEstado().cargando) {
        actualizarEstado({
          cargando: false,
          error: obtenerEstado().error ?? 'La carga está tardando más de lo normal. Comprueba tu conexión.',
        });
      }
    }, 12000);
  }

  suscribir((estado) => {
    renderAvisos(estado);
    // El selector de controles cambia zonaId en memoria sin más (está
    // pensado también para src/pages/index.astro). Aquí se compara contra
    // `zonaMostrada` —la zona realmente en pantalla—, no contra
    // `zonaDeLaPagina` —la que fijó el build—: tras un cambio de zona sin
    // recargar, las dos dejan de coincidir a propósito. Si la revierte
    // `cambiarZona` por un fallo de carga, `estado.zonaId` vuelve a ser
    // `zonaMostrada` y esta condición no se dispara.
    if (estado.zonaId === zonaMostrada) return;
    if (esPaginaDeZona) {
      // `true`: esta rama solo se dispara por un cambio de `zonaId` en
      // memoria (el selector, o RF-37 con la ubicación), nunca por
      // `popstate` —ese llama a `cambiarZona` directamente, más arriba,
      // sin pasar por aquí—, así que siempre hay que empujar la dirección.
      cambiarZona(estado.zonaId ?? zonaMostrada, true);
    } else {
      // Página de municipio: elegir zona sigue siendo una navegación
      // completa, también "ascendiendo" desde el municipio a la
      // zona/provincia recién elegida (comportamiento sin cambios, RF-88
      // primera parte no lo toca).
      location.href = `/${estado.zonaId}/`;
    }
  });
  renderAvisos(obtenerEstado());

  montarLista(contenedorLista);
  montarTotem(contenedorTotem);

  // RF-37: al encontrar la ubicación se cambia zonaId a la provincia más
  // cercana. Aquí eso dispara la navegación de arriba, a la página estática
  // de esa provincia.
  function alEncontrarUbicacion(posicion: { lat: number; lon: number }): void {
    if (!indice) return;
    const provincia = provinciaMasCercana(indice, posicion);
    actualizarEstado({ zonaId: `p-${provincia.id}` });
  }

  // import() dinámico para que MapLibre entre en su propio chunk, aparte
  // del bundle inicial (RNF-11), y para que un fallo de red al pedir ese
  // chunk no rompa el resto de la página (regla dura 2 de CLAUDE.md).
  import('./Mapa.ts')
    .then(({ montarMapa }) => montarMapa(contenedorMapa, alEncontrarUbicacion))
    .catch(() => {
      contenedorMapa.innerHTML = '';
      contenedorMapa.removeAttribute('style');
      const aviso = document.createElement('p');
      aviso.textContent = 'El mapa no se ha podido cargar. La lista y la ficha funcionan igual.';
      contenedorMapa.append(aviso);
    });
</script>
