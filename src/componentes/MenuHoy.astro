---
import { EDITORIALES_HOY, HERRAMIENTAS_HOY, entradaHoyActiva, hrefEntradaHoy, seccionHoyActiva } from '../datos/navegacion.ts';
import { formatearFechaHora } from '../logica/formato.ts';
import { formatearResumenHoy, leerResumenesPanelHoy, type SlugResumenHoy } from '../../scripts/lib/resumenes-hoy.ts';

interface Props { prefijo?: string; provinciaId?: string | null; municipio?: string | null; autonomo?: boolean; variante?: 'clara' | 'petroleo'; }
const { prefijo = '', provinciaId = null, municipio = null, autonomo = false, variante = 'clara' } = Astro.props;
const id = (base: string) => prefijo ? `${base}-${prefijo}` : base;
const pathname = Astro.url.pathname;
const hoyActivo = seccionHoyActiva(pathname);
const resumenes = await leerResumenesPanelHoy(provinciaId);
const descripcionDe = (slug: string, descripcion: string): string =>
  slug === 'como-calculamos-los-datos'
    ? descripcion
    : formatearResumenHoy(resumenes.items[slug as SlugResumenHoy]);
---
<div class:list={['navegacion-hoy', `navegacion-hoy--${variante}`]} data-menu-hoy-autonomo={autonomo ? '' : undefined}>
  <button id={id('boton-hoy')} type="button" class:list={['boton-hoy', { 'boton-hoy--activo': hoyActivo }]} aria-expanded="false" aria-controls={id('panel-hoy')} aria-haspopup="true">
    <span class="boton-hoy__texto">Hoy</span>
    <svg class="boton-hoy__icono" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" /></svg>
    <span class="boton-hoy__flecha" aria-hidden="true"></span>
  </button>
  <div id={id('fondo-panel-hoy')} class="panel-hoy__fondo" hidden></div>
  <nav id={id('panel-hoy')} class="panel-hoy" aria-label="Análisis de precios de hoy" data-panel-hoy hidden>
    <div class="panel-hoy__superior">
      <span class="panel-hoy__asa" aria-hidden="true"></span>
      <div class="panel-hoy__cabecera">
        <span><span class="micro">ANÁLISIS DE HOY</span><strong class="panel-hoy__titulo">Hoy, en cifras</strong></span>
        <button id={id('cerrar-panel-hoy')} type="button" class="boton-cerrar" aria-label="Cerrar análisis de hoy">✕</button>
      </div>
    </div>
    <p class="panel-hoy__grupo">EDITORIALES DE HOY</p>
    <ul class="panel-hoy__lista">
      {EDITORIALES_HOY.map((entrada) => (
        <li><a href={hrefEntradaHoy(entrada, provinciaId, municipio)} data-enlace-evolucion-zona={entrada.slug === 'evolucion' ? '' : undefined} class:list={{ 'panel-hoy__enlace--activo': entradaHoyActiva(pathname, entrada) }} aria-current={entradaHoyActiva(pathname, entrada) ? 'page' : undefined}>
          <span class="panel-hoy__texto"><strong>{entrada.nombre}</strong><small>{descripcionDe(entrada.slug, entrada.descripcion)}</small></span>
        </a></li>
      ))}
    </ul>
    <p class="panel-hoy__grupo">HERRAMIENTA Y METODOLOGÍA</p>
    <ul class="panel-hoy__lista">
      {HERRAMIENTAS_HOY.map((entrada) => (
        <li><a href={hrefEntradaHoy(entrada, provinciaId, municipio)} data-enlace-evolucion-zona={entrada.slug === 'evolucion' ? '' : undefined} class:list={{ 'panel-hoy__enlace--activo': entradaHoyActiva(pathname, entrada) }} aria-current={entradaHoyActiva(pathname, entrada) ? 'page' : undefined}>
          <span class="panel-hoy__texto"><strong>{entrada.nombre}</strong><small>{descripcionDe(entrada.slug, entrada.descripcion)}</small></span>
        </a></li>
      ))}
    </ul>
    <footer class="panel-hoy__pie">
      <p>Datos oficiales del Ministerio para la Transición Ecológica y el Reto Demográfico.</p>
      <p class="panel-hoy__actualizado">Datos actualizados · <time datetime={resumenes.actualizado}>{formatearFechaHora(resumenes.actualizado)}</time></p>
      <p>Sin anuncios · Sin registro · Sin rastreo</p>
    </footer>
  </nav>
</div>
<noscript><style>
  .navegacion-hoy > .boton-hoy, .navegacion-hoy > .panel-hoy__fondo { display:none !important; }
  .navegacion-hoy > .panel-hoy[hidden] { position:static; display:block !important; width:min(482px,100%); max-height:none; margin:8px; }
</style></noscript>

{autonomo && <script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-menu-hoy-autonomo]')) {
    if (raiz.dataset.montado) continue;
    raiz.dataset.montado = 'true';
    const boton = raiz.querySelector<HTMLButtonElement>('.boton-hoy')!;
    const panel = raiz.querySelector<HTMLElement>('.panel-hoy')!;
    const fondo = raiz.querySelector<HTMLElement>('.panel-hoy__fondo')!;
    const cerrar = raiz.querySelector<HTMLButtonElement>('.boton-cerrar')!;
    const elementosFoco = () => Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
    const ocultar = (devolverFoco = false) => { panel.hidden = true; fondo.hidden = true; document.body.classList.remove('menu-hoy-abierto'); boton.setAttribute('aria-expanded', 'false'); if (devolverFoco) boton.focus(); };
    const mostrar = () => { panel.hidden = false; fondo.hidden = false; document.body.classList.add('menu-hoy-abierto'); boton.setAttribute('aria-expanded', 'true'); elementosFoco()[0]?.focus(); };
    boton.addEventListener('click', () => panel.hidden ? mostrar() : ocultar());
    cerrar.addEventListener('click', () => ocultar(true));
    fondo.addEventListener('click', () => ocultar(true));
    document.addEventListener('pointerdown', (evento) => { if (!panel.hidden && !raiz.contains(evento.target as Node)) ocultar(true); });
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !panel.hidden) { evento.preventDefault(); ocultar(true); return; }
      if (evento.key !== 'Tab' || panel.hidden) return;
      const focables = elementosFoco(); const primero = focables[0]; const ultimo = focables.at(-1);
      if (!primero || !ultimo) return;
      if (evento.shiftKey && document.activeElement === primero) { evento.preventDefault(); ultimo.focus(); }
      else if (!evento.shiftKey && document.activeElement === ultimo) { evento.preventDefault(); primero.focus(); }
    });
  }
</script>}
