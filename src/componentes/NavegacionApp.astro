---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { cajaDeTitulo } from '../logica/formato.ts';
import { estacionesDeZona } from '../logica/zona.ts';
import type { Indice, Zona } from '../../scripts/lib/tipos.ts';

interface Props {
  zonaId?: string | null;
  zonaNombre?: string | null;
}

const { zonaId = null, zonaNombre = null } = Astro.props;
const indice = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'indice.json'), 'utf-8'),
) as Indice;
const zonas = [...indice.zonas].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const nombresRepetidos = new Set(
  zonas
    .map((zona) => zona.nombre.trim().toLocaleLowerCase('es'))
    .filter((nombre, posicion, nombres) => nombres.indexOf(nombre) !== posicion),
);
const tipos: { tipo: Zona['tipo']; etiqueta: string }[] = [
  { tipo: 'provincia', etiqueta: 'Provincias' },
  { tipo: 'ccaa', etiqueta: 'Comunidades autónomas' },
];
const zonaActual = zonas.find((zona) => zona.id === zonaId);
const estacionesZonaActual = zonaActual
  ? estacionesDeZona(zonaActual, indice.provincias)
  : null;
const provinciaEvolucion = zonaActual?.tipo === 'provincia' ? zonaActual.provincias[0] : null;
const editoriales = [
  { href: provinciaEvolucion ? `/hoy/evolucion/${provinciaEvolucion}/` : '/hoy/evolucion/', nombre: 'Evolución de precios', descripcion: 'Cambios en los últimos 30 días' },
  { href: '/hoy/provincias-mas-baratas/', nombre: 'Provincias más baratas', descripcion: 'Compara medias y mínimos' },
  { href: '/hoy/cuanto-te-juegas/', nombre: 'Cuánto puedes ahorrar', descripcion: 'Ahorro posible por depósito' },
  { href: '/hoy/marcas-mas-baratas/', nombre: 'Marcas más baratas', descripcion: 'Ranking por cadenas' },
  { href: '/hoy/capitales-de-provincia/', nombre: 'Capitales de provincia', descripcion: 'Precios en grandes ciudades' },
  { href: '/hoy/la-mas-barata-de-espana/', nombre: 'La más barata de España', descripcion: 'El mínimo nacional de hoy' },
];
---

<div id="controles-identidad" class="controles-identidad" aria-label="Zona">
  <div class="controles__zona">
    <button id="boton-zona" type="button" class="boton-zona" aria-expanded="false" aria-controls="panel-zona">
      <span class="boton-zona__etiqueta">Zona</span>
      <span id="nombre-zona" class="boton-zona__nombre">{zonaNombre ?? 'Elige tu zona'}</span>
      <span class="boton-zona__flecha" aria-hidden="true"></span>
    </button>

    <div id="fondo-panel-zona" class="panel-fondo" hidden></div>
    <section id="panel-zona" class="panel-zona" role="dialog" aria-modal="true" aria-labelledby="titulo-panel-zona" hidden>
      <span class="panel-zona__asa" aria-hidden="true"></span>
      <header class="panel-zona__cabecera">
        <div>
          <h2 id="titulo-panel-zona" class="panel-zona__titulo">Cambiar zona</h2>
          <p class="panel-zona__ayuda">
            <span class="panel-zona__ayuda-desktop">Elige una </span>provincia o comunidad autónoma
          </p>
        </div>
        <button id="cerrar-panel-zona" type="button" class="boton-cerrar" aria-label="Cerrar selector de zona">✕</button>
        <input id="buscar-zona" type="search" class="panel-zona__buscar" placeholder="Buscar por nombre…" aria-label="Buscar zona" />
      </header>

      <div id="grupos-zona" class="panel-zona__grupos">
        {zonaActual && estacionesZonaActual !== null && (
          <a
            href={`/${zonaActual.id}/`}
            class="panel-zona__actual"
            aria-current="page"
          >
            <span class="panel-zona__actual-textos">
              <span class="panel-zona__actual-etiqueta">Zona actual</span>
              <strong>{cajaDeTitulo(zonaActual.nombre)}</strong>
            </span>
            <span class="panel-zona__actual-recuento">
              {estacionesZonaActual}<span> estaciones</span>
            </span>
          </a>
        )}
        {tipos.map(({ tipo, etiqueta }) => {
          const opciones = zonas.filter((zona) => zona.tipo === tipo && zona.id !== zonaId);
          return (
            <section class="enlaces-bloque" data-grupo-zona>
              <h3 class="enlaces-bloque__titulo micro">{etiqueta}</h3>
              <ul class="enlaces-bloque__filas">
                {opciones.map((zona) => (
                  <li data-opcion-zona data-busqueda={zona.nombre}>
                    <a
                      href={`/${zona.id}/`}
                      class="enlaces-bloque__fila enlaces-bloque__fila--zona"
                      data-zona-id={zona.id}
                      aria-current={zona.id === zonaId ? 'page' : undefined}
                    >
                      <span class="enlaces-bloque__info">
                        <span class="enlaces-bloque__nombre">{cajaDeTitulo(zona.nombre)}</span>
                        {nombresRepetidos.has(zona.nombre.trim().toLocaleLowerCase('es')) && (
                          <span class="enlaces-bloque__tipo">
                            {zona.tipo === 'provincia' ? 'Provincia' : 'Comunidad autónoma'}
                          </span>
                        )}
                      </span>
                      <span class="enlaces-bloque__recuento">{estacionesDeZona(zona, indice.provincias)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
        <div class="panel-zona__difuminado" aria-hidden="true"></div>
      </div>
    </section>
  </div>
</div>

<div class="navegacion-hoy">
  <button id="boton-hoy" type="button" class="boton-hoy" aria-expanded="false" aria-controls="panel-hoy">
    <span class="boton-hoy__texto">Hoy</span>
    <svg class="boton-hoy__icono" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" />
    </svg>
    <span class="boton-hoy__flecha" aria-hidden="true"></span>
  </button>
  <div id="fondo-panel-hoy" class="panel-hoy__fondo" hidden></div>
  <nav id="panel-hoy" class="panel-hoy" aria-label="Análisis de precios de hoy" aria-modal="true" hidden>
    <span class="panel-hoy__asa" aria-hidden="true"></span>
    <div class="panel-hoy__cabecera">
      <span>
        <span class="micro">ANÁLISIS DE HOY</span>
        <strong class="panel-hoy__titulo">Descubre los datos</strong>
      </span>
      <button id="cerrar-panel-hoy" type="button" class="boton-cerrar" aria-label="Cerrar análisis de hoy">✕</button>
    </div>
    <ul class="panel-hoy__lista">
      {editoriales.map((editorial, indice) => (
        <li>
          <a href={editorial.href} class:list={{ 'panel-hoy__enlace--activo': indice === 0 }}>
            <span class="panel-hoy__icono" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {indice === 0 && <path d="M4 19V9m5 10V5m5 14v-7m5 7V3M3 8l5-4 5 4 7-7" />}
                {indice === 1 && <path d="m3 6 5-3 8 3 5-3v15l-5 3-8-3-5 3zM8 3v15m8-12v15" />}
                {indice === 2 && <path d="M7 10V8a5 5 0 0 1 10 0v2m-7 0h8a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3H8a5 5 0 0 1-5-5v-2a3 3 0 0 1 3-3h4zm3 3v4m-2-2h4" />}
                {indice === 3 && <path d="m12 2 3 2 4 .5.5 4 2.5 3-2.5 3-.5 4-4 .5-3 2-3-2-4-.5-.5-4L2 11l2.5-3 .5-4 4-.5zM9 12h6m-5-3h4m-4 6h4" />}
                {indice === 4 && <path d="M4 21V8h8v13M8 8V3h10v18M2 21h20M7 12h2m-2 4h2m5-9h2m-2 4h2m-2 4h2" />}
                {indice === 5 && <path d="M8 4h8v4a4 4 0 0 1-8 0zM8 6H4v1a4 4 0 0 0 4 4m8-5h4v1a4 4 0 0 1-4 4m-4 1v5m-4 3h8" />}
              </svg>
            </span>
            <span class="panel-hoy__texto"><strong>{editorial.nombre}</strong><small>{editorial.descripcion}</small></span>
            <span aria-hidden="true">›</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>
