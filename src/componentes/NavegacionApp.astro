---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { nombreVisible } from '../logica/formato.ts';
import { estacionesDeZona } from '../logica/zona.ts';
import type { Indice, Zona } from '../../scripts/lib/tipos.ts';
import MenuHoy from './MenuHoy.astro';

interface Props {
  zonaId?: string | null;
  zonaNombre?: string | null;
  mostrarMenuHoy?: boolean;
  tituloSelector?: string;
  ayudaSelector?: string;
}

const {
  zonaId = null,
  zonaNombre = null,
  mostrarMenuHoy = true,
  tituloSelector = 'Cambiar zona',
  ayudaSelector = 'Elige una provincia o comunidad autónoma',
} = Astro.props;
const indice = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'indice.json'), 'utf-8'),
) as Indice;
const zonas = [...indice.zonas].sort((a, b) => nombreVisible(a.nombre, a.tipo).localeCompare(nombreVisible(b.nombre, b.tipo), 'es'));
const nombresRepetidos = new Set(
  zonas
    .map((zona) => zona.nombre.trim().toLocaleLowerCase('es'))
    .filter((nombre, posicion, nombres) => nombres.indexOf(nombre) !== posicion),
);
const tipos: { tipo: Zona['tipo']; etiqueta: string }[] = [
  { tipo: 'provincia', etiqueta: 'Provincias' },
  { tipo: 'ccaa', etiqueta: 'Comunidades autónomas' },
];
const zonaActual = zonas.find((zona) => zona.id === zonaId);
const zonaNombreVisible = zonaActual ? nombreVisible(zonaActual.nombre, zonaActual.tipo) : zonaNombre;
const estacionesZonaActual = zonaActual
  ? estacionesDeZona(zonaActual, indice.provincias)
  : null;
const provinciaEvolucion = zonaActual?.tipo === 'provincia' ? zonaActual.provincias[0] : null;
---

<div id="controles-identidad" class="controles-identidad" aria-label="Zona">
  <div class="controles__zona">
    <button id="boton-zona" type="button" class="boton-zona" aria-expanded="false" aria-controls="panel-zona" aria-label={zonaNombreVisible ? `Cambiar zona. Zona actual: ${zonaNombreVisible}` : 'Elegir zona'}>
      <span class="boton-zona__etiqueta">Zona</span>
      <span id="nombre-zona" class="boton-zona__nombre">{zonaNombreVisible ?? 'Elige tu zona'}</span>
      <span class="boton-zona__flecha" aria-hidden="true"></span>
    </button>

    <div id="fondo-panel-zona" class="panel-fondo" hidden></div>
    <section id="panel-zona" class="panel-zona" role="dialog" aria-modal="true" aria-labelledby="titulo-panel-zona" hidden>
      <span class="panel-zona__asa" aria-hidden="true"></span>
      <header class="panel-zona__cabecera">
        <div>
          <h2 id="titulo-panel-zona" class="panel-zona__titulo">{tituloSelector}</h2>
          <p class="panel-zona__ayuda">{ayudaSelector}</p>
        </div>
        <button id="cerrar-panel-zona" type="button" class="boton-cerrar" aria-label="Cerrar selector de zona">✕</button>
        <span class="panel-zona__buscar-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m16 16 5 5" /></svg>
        </span>
        <input id="buscar-zona" type="search" class="panel-zona__buscar" placeholder="Buscar por nombre…" aria-label="Buscar zona" />
      </header>

      <div id="grupos-zona" class="panel-zona__grupos">
        {zonaActual && estacionesZonaActual !== null && (
          <a
            href={`/${zonaActual.id}/`}
            class="panel-zona__actual"
            data-zona-actual
            aria-current="page"
          >
            <span class="panel-zona__actual-textos">
              <span class="panel-zona__actual-etiqueta">Zona actual</span>
              <strong data-zona-actual-nombre>{nombreVisible(zonaActual.nombre, zonaActual.tipo)}</strong>
            </span>
            <span class="panel-zona__actual-recuento" data-zona-actual-recuento>
              {estacionesZonaActual}<span> estaciones</span>
            </span>
          </a>
        )}
        {tipos.map(({ tipo, etiqueta }) => {
          // Se sirven todas las zonas, incluida la inicial. El cliente oculta
          // la activa; así, tras cambiar en sitio, puede mostrar la anterior
          // de nuevo sin tener que reconstruir el selector.
          const opciones = zonas.filter((zona) => zona.tipo === tipo);
          return (
            <section class="enlaces-bloque" data-grupo-zona>
              <h3 class="enlaces-bloque__titulo micro">{etiqueta}</h3>
              <ul class="enlaces-bloque__filas">
                {opciones.map((zona) => (
                  <li
                    data-opcion-zona
                    data-busqueda={`${zona.nombre} ${nombreVisible(zona.nombre, zona.tipo)}`}
                    hidden={zona.id === zonaId}
                  >
                    <a
                      href={`/${zona.id}/`}
                      class="enlaces-bloque__fila enlaces-bloque__fila--zona"
                      data-zona-id={zona.id}
                      aria-current={zona.id === zonaId ? 'page' : undefined}
                    >
                      <span class="enlaces-bloque__info">
                        <span class="enlaces-bloque__nombre">{nombreVisible(zona.nombre, zona.tipo)}</span>
                        {nombresRepetidos.has(zona.nombre.trim().toLocaleLowerCase('es')) && (
                          <span class="enlaces-bloque__tipo">
                            {zona.tipo === 'provincia' ? 'Provincia' : 'Comunidad autónoma'}
                          </span>
                        )}
                      </span>
                      <span class="enlaces-bloque__recuento">{estacionesDeZona(zona, indice.provincias)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
        <div class="panel-zona__difuminado" aria-hidden="true"></div>
      </div>
    </section>
  </div>
</div>

{mostrarMenuHoy && <MenuHoy provinciaId={provinciaEvolucion} />}
