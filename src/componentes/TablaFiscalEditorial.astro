---
import type { AgregadoZona } from '../../scripts/lib/agregados.ts';
import type { FilaRanking } from '../../scripts/lib/ranking.ts';
import type { ClavePrecio } from '../../scripts/lib/tipos.ts';
import { formatearNumero, formatearPrecio, nombreVisible } from '../logica/formato.ts';

interface Props {
  filas: FilaRanking<AgregadoZona>[];
  combustible: ClavePrecio;
}

const { filas, combustible } = Astro.props;
---

<div class="editorial-tabla-wrap">
  <table class="editorial-tabla">
    <thead>
      <tr>
        <th scope="col" class="editorial-tabla__posicion">Pos.</th>
        <th scope="col">Territorio</th>
        <th scope="col" class="editorial-tabla__numero">Media</th>
        <th scope="col" class="editorial-tabla__numero">Estaciones</th>
      </tr>
    </thead>
    <tbody>
      {filas.map(({ elemento: provincia, posicion }) => {
        const resumen = provincia.combustibles[combustible];
        return (
          <tr>
            <td class="editorial-tabla__posicion">{posicion ?? '—'}</td>
            <td class="editorial-tabla__zona">
              <a href={`/${provincia.id}/`}>{nombreVisible(provincia.nombre, 'provincia')}</a>
              <small class="editorial-tabla__muestra">{formatearNumero(resumen.n)} {resumen.n === 1 ? 'estación' : 'estaciones'}</small>
            </td>
            <td class:list={['editorial-tabla__numero', 'editorial-tabla__media', { 'editorial-tabla__ausente': resumen.media === null }]}>
              {resumen.media === null ? 'no vende' : `${formatearPrecio(resumen.media)} €/L`}
            </td>
            <td class="editorial-tabla__numero editorial-tabla__estaciones">
              {formatearNumero(resumen.n)}<span class="editorial-tabla__unidad"> {resumen.n === 1 ? 'estación' : 'estaciones'}</span>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
