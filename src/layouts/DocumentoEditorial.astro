---
import '../estilos/tokens.css';
import '../estilos/editorial.css';
import '../estilos/navegacion-global.css';
import marcaSvg from '../assets/marca.svg?raw';
import CabeceraGlobal from '../componentes/CabeceraGlobal.astro';
import NavegacionApp from '../componentes/NavegacionApp.astro';
import { EDITORIALES_HOY, HERRAMIENTAS_HOY, hrefEntradaHoy } from '../datos/navegacion.ts';
import { formatearFechaHora } from '../logica/formato.ts';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  imagenCompartir?: string;
  actualizado?: string;
}

const {
  titulo,
  descripcion,
  ruta,
  imagenCompartir = '/og/predeterminada.png',
  actualizado,
} = Astro.props;
const canonical = new URL(ruta, Astro.site);
const imagenAbsoluta = new URL(imagenCompartir, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16323B" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <CabeceraGlobal modo="editorial" variante="petroleo" />
    <div class="selector-zona-editorial" data-selector-zona-editorial>
      <NavegacionApp
        mostrarMenuHoy={false}
        tituloSelector="¿Dónde quieres ver precios?"
        ayudaSelector="Elige una zona para abrir la aplicación"
      />
    </div>
    <main class="editorial-documento">
      <slot />
    </main>
    <footer class="editorial-pie" id="pie-editorial">
      <div class="editorial-pie__interior">
        <div class="editorial-pie__proyecto">
          <a class="editorial-pie__marca" href="/">
            <span class="editorial-marca__icono" aria-hidden="true" set:html={marcaSvg} />
            <span>Surtidor</span>
          </a>
          <p class="editorial-pie__lema">Sin anuncios · Sin registro · Sin rastreo</p>
          <span class="editorial-pie__separador" aria-hidden="true"></span>
          <p class="editorial-pie__fuente">Datos oficiales del Ministerio para la Transición Ecológica y el Reto Demográfico.</p>
          {actualizado && <p class="editorial-pie__actualizado">Datos actualizados · <time datetime={actualizado}>{formatearFechaHora(actualizado)}</time></p>}
        </div>
        <nav class="editorial-pie__navegacion" aria-label="Más en Surtidor">
          <p>MÁS EN SURTIDOR</p>
          <div class="editorial-pie__enlaces">
            {EDITORIALES_HOY.map((entrada) => <a href={hrefEntradaHoy(entrada)}>{entrada.nombre}</a>)}
            {HERRAMIENTAS_HOY.map((entrada) => <a href={hrefEntradaHoy(entrada)}>{entrada.nombre}</a>)}
          </div>
        </nav>
        <a class="editorial-pie__arriba" href="/">PORTADA</a>
      </div>
    </footer>
    <script>
      import { obtenerEstado } from '../logica/estado.ts';
      import { montarSelectorZona } from '../componentes/SelectorZona.ts';

      const contenedor = document.querySelector<HTMLElement>('[data-selector-zona-editorial]');
      const marca = document.querySelector<HTMLAnchorElement>('.cabecera-global .marca-global');
      const enlacePrecios = document.querySelector<HTMLAnchorElement>('.cabecera-global__nav > a[href="/"]');
      const enlacesEntrada = [marca, enlacePrecios].filter((enlace): enlace is HTMLAnchorElement => enlace !== null);
      if (contenedor) {
        const idsDisponibles = new Set(Array.from(contenedor.querySelectorAll<HTMLAnchorElement>('[data-zona-id]'), (enlace) => enlace.dataset.zonaId));
        const zonaGuardada = obtenerEstado().zonaId;
        const destinoGuardado = zonaGuardada && idsDisponibles.has(zonaGuardada) ? `/${zonaGuardada}/` : null;
        const selector = montarSelectorZona(contenedor);
        const movil = window.matchMedia('(max-width: 760px)');

        if (destinoGuardado && movil.matches && enlacePrecios) enlacePrecios.href = destinoGuardado;
        for (const enlace of enlacesEntrada) {
          enlace.addEventListener('click', (evento) => {
            if (!movil.matches || destinoGuardado) return;
            evento.preventDefault();
            selector.abrir(enlace);
          });
        }
      }
    </script>
  </body>
</html>
