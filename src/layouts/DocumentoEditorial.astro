---
import '../estilos/tokens.css';
import '../estilos/editorial.css';
import '../estilos/navegacion-global.css';
import marcaSvg from '../assets/marca.svg?raw';
import CabeceraGlobal from '../componentes/CabeceraGlobal.astro';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  imagenCompartir?: string;
}

const {
  titulo,
  descripcion,
  ruta,
  imagenCompartir = '/og/predeterminada.png',
} = Astro.props;
const canonical = new URL(ruta, Astro.site);
const imagenAbsoluta = new URL(imagenCompartir, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16323B" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <CabeceraGlobal modo="editorial" variante="petroleo" />
    <main class="editorial-documento">
      <slot />
    </main>
    <footer class="editorial-pie">
      <div class="editorial-pie__interior">
        <div class="editorial-pie__proyecto">
          <a class="editorial-pie__marca" href="/">
            <span class="editorial-marca__icono" aria-hidden="true" set:html={marcaSvg} />
            <span>Surtidor</span>
          </a>
          <p>Precios de carburantes de España, sin anuncios ni registro.</p>
          <p class="editorial-pie__fuente">
            Datos oficiales del Ministerio para la Transición Ecológica y el Reto Demográfico.
          </p>
        </div>
        <nav class="editorial-pie__navegacion" aria-label="Pie de página">
          <div>
            <span>Explorar</span>
            <a href="/">Precios de hoy</a>
            <a href="/hoy/provincias-mas-baratas/">Provincias</a>
            <a href="/hoy/marcas-mas-baratas/">Marcas más baratas</a>
          </div>
          <div>
            <span class="editorial-pie__titulo">Información</span>
            <a href="/hoy/cuanto-te-juegas/">Metodología</a>
            <a href="/hoy/canarias-ceuta-melilla/"><span class="editorial-pie__texto-largo">Fuentes de datos</span><span class="editorial-pie__texto-corto">Datos</span></a>
            <span class="editorial-pie__texto">Privacidad</span>
          </div>
        </nav>
        <a class="editorial-pie__arriba" href="#">Volver arriba ↑</a>
      </div>
    </footer>
  </body>
</html>
