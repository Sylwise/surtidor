---
import '../estilos/tokens.css';
import '../estilos/editorial.css';
import marcaSvg from '../assets/marca.svg?raw';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  imagenCompartir?: string;
}

const {
  titulo,
  descripcion,
  ruta,
  imagenCompartir = '/og/predeterminada.png',
} = Astro.props;
const canonical = new URL(ruta, Astro.site);
const imagenAbsoluta = new URL(imagenCompartir, Astro.site);
const editoriales = [
  { href: '/hoy/provincias-mas-baratas/', nombre: 'Provincias más baratas' },
  { href: '/hoy/cuanto-te-juegas/', nombre: 'Ahorro por depósito' },
  { href: '/hoy/marcas-mas-baratas/', nombre: 'Marcas más baratas' },
  { href: '/hoy/capitales-de-provincia/', nombre: 'Capitales de provincia' },
  { href: '/hoy/la-mas-barata-de-espana/', nombre: 'La más barata de España' },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16323B" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="editorial-cabecera">
      <a class="editorial-marca" href="/" aria-label="Surtidor, volver a la portada">
        <span class="editorial-marca__icono" aria-hidden="true" set:html={marcaSvg} />
        <span>Surtidor</span>
      </a>
      <span class="editorial-seccion">Hoy</span>
    </header>
    <main class="editorial-documento">
      <slot />
    </main>
    <footer class="editorial-pie">
      <div class="editorial-pie__interior">
        <div class="editorial-pie__proyecto">
          <a class="editorial-pie__marca" href="/">
            <span class="editorial-marca__icono" aria-hidden="true" set:html={marcaSvg} />
            <span>Surtidor</span>
          </a>
          <p>Precios de carburantes de España, sin anuncios ni registro.</p>
          <p class="editorial-pie__fuente">
            Datos oficiales del Ministerio para la Transición Ecológica y el Reto Demográfico.
          </p>
        </div>
        <nav class="editorial-pie__navegacion" aria-label="Páginas editoriales">
          <span>Hoy</span>
          <ul>
            {editoriales.map((editorial) => (
              <li>
                {ruta === editorial.href ? (
                  <span class="editorial-pie__actual" aria-current="page">{editorial.nombre}</span>
                ) : (
                  <a href={editorial.href}>{editorial.nombre}</a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
