---
// H10 · Una página estática por zona, para SEO (docs/06-roadmap.md#H10,
// ADR-0004). Mismo contenido interactivo que src/pages/index.astro —
// Controles, Lista, Totem, Mapa y la hoja inferior de ADR-0006, ahora en
// src/componentes/AppInteractiva.astro— pero con la zona activa fijada
// desde la URL, y <title>/<meta description> propios por zona para que
// Google indexe cada una por separado.
//
// `[...zona]`, parámetro resto, no `[zona]`: ADR-0018 hace que `zona.id` sea
// ya la ruta entera (uno o dos tramos: "barcelona" o "comunidad/madrid"), así
// que un solo fichero cubre las dos formas sin duplicar esta página bajo
// `src/pages/comunidad/[zona]/`.
//
// El frontmatter corre en Node durante el build: lee public/data/indice.json
// del disco (no por fetch) para generar un path estático por zona.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
// `process.cwd()`, no `import.meta.dirname`: `astro build` empaqueta el
// getStaticPaths de cada ruta dinámica en dist/.prerender/chunks/ antes de
// ejecutarlo, así que en build import.meta.dirname ya no apunta a
// src/pages/[...zona]/ (sí lo hace en `astro dev`, que ejecuta el fichero en
// su sitio). Contar ../../../ a mano "funciona" en build por pura coincidencia
// de profundidad con dist/.prerender/chunks/, y deja de coincidir en
// cualquier ruta anidada un nivel más —ver
// src/pages/[provincia]/[municipio]/index.astro, donde sí rompió—.
// npm run build/dev siempre se invoca desde la raíz del repo, así que
// process.cwd() es estable en los dos modos.
import '../../estilos/tokens.css';
import '../../estilos/interfaz.css';
import AppInteractiva from '../../componentes/AppInteractiva.astro';
import { fusionarProvincias, UMBRAL_HIDRATACION_EMBEBIDA } from '../../logica/zona.ts';
import { tituloZona, descripcionZona } from '../../logica/metaZona.ts';
import { nombreVisible } from '../../logica/formato.ts';
import type { DatosProvincia, Indice, Zona } from '../../../scripts/lib/tipos.ts';

const DIRECTORIO_DATOS = join(process.cwd(), 'public', 'data');

export async function getStaticPaths() {
  // Ruta calculada de nuevo aquí dentro, sin usar la constante de arriba:
  // Astro extrae `getStaticPaths` a su propio módulo para el build y no
  // arrastra con él las constantes del resto del frontmatter.
  const rutaIndice = join(process.cwd(), 'public', 'data', 'indice.json');
  const indice = JSON.parse(readFileSync(rutaIndice, 'utf-8')) as Indice;

  return indice.zonas.map((zona) => ({
    params: { zona: zona.id },
    props: { zona },
  }));
}

interface Props {
  zona: Zona;
}

const { zona } = Astro.props;

const zonaVisible = nombreVisible(zona.nombre, zona.tipo);
const titulo = tituloZona(zona.nombre, zona.tipo);
const descripcion = descripcionZona(zona.nombre, zona.tipo);
const canonical = new URL(`/${zona.id}/`, Astro.site);
// H11 (RF-66): la tarjeta la genera scripts/generar-imagenes-compartir.ts en
// el build, con el mismo id de zona que esta ruta. og:image tiene que ser
// una URL ABSOLUTA — WhatsApp no resuelve rutas relativas y el fallo es
// silencioso, así que se construye con Astro.site igual que `canonical`.
const imagenCompartir = new URL(`/og/${zona.id}.png`, Astro.site);

// RF-61: los precios tienen que estar en el HTML servido, no inyectados solo
// por JavaScript. Esto corre en Node durante el build (igual que
// getStaticPaths arriba): lee los ficheros de provincia de la zona del disco,
// sin red, y los fusiona con la misma función que usa el cliente al cambiar
// de zona (src/logica/zona.ts), para que las dos vías no diverjan.
const datosPorProvincia: DatosProvincia[] = zona.provincias.map((id) => {
  const ruta = join(DIRECTORIO_DATOS, 'provincias', `${id}.json`);
  return JSON.parse(readFileSync(ruta, 'utf-8')) as DatosProvincia;
});
const { estaciones, mock, actualizado } = fusionarProvincias(datosPorProvincia);

// Solo por debajo de UMBRAL_HIDRATACION_EMBEBIDA (ver el porqué en
// src/logica/zona.ts) va embebido el bloque de hidratación del widget
// interactivo; por encima, AppInteractiva pide los JSON de provincia por
// fetch, como antes de H10.
const hidratacionEmbebida = estaciones.length <= UMBRAL_HIDRATACION_EMBEBIDA;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16323B" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- RF-93. La lista es el contenido (docs/05-diseno.md): no hay tabla
         aparte debajo del mapa. AppInteractiva la pinta a partir de
         `estaciones` (RF-89) y cierra con los enlaces a los municipios de la
         propia zona (RF-92, ADR-0017). Este <h1> es el encabezado principal
         del documento, fuera de pantalla — igual que en la página de
         municipio: el "una pantalla, una pregunta" del diseño no tiene sitio
         para un título grande sin quitarle presupuesto a la lista. -->
    <h1 class="sr-only">Gasolineras en {zonaVisible}</h1>
    <AppInteractiva
      zonaId={zona.id}
      zonaNombre={zonaVisible}
      hidratacionEmbebida={hidratacionEmbebida}
      estaciones={estaciones}
      mock={mock}
      actualizado={actualizado}
      esPaginaDeZona={true}
    />
  </body>
</html>
