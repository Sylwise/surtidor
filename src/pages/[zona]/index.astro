---
// H10 · Una página estática por zona, para SEO (docs/06-roadmap.md#H10,
// ADR-0004). Mismo contenido interactivo que src/pages/index.astro —
// Controles, Lista, Totem, Mapa y la hoja inferior de ADR-0006, ahora en
// src/componentes/AppInteractiva.astro— pero con la zona activa fijada
// desde la URL, y <title>/<meta description> propios por zona para que
// Google indexe cada una por separado.
//
// El frontmatter corre en Node durante el build: lee public/data/indice.json
// del disco (no por fetch) para generar un path estático por zona.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
// `process.cwd()`, no `import.meta.dirname`: `astro build` empaqueta el
// getStaticPaths de cada ruta dinámica en dist/.prerender/chunks/ antes de
// ejecutarlo, así que en build import.meta.dirname ya no apunta a
// src/pages/[zona]/ (sí lo hace en `astro dev`, que ejecuta el fichero en su
// sitio). Contar ../../../ a mano "funciona" en build por pura coincidencia
// de profundidad con dist/.prerender/chunks/, y deja de coincidir en
// cualquier ruta anidada un nivel más —ver
// src/pages/[provincia]/[municipio]/index.astro, donde sí rompió—.
// npm run build/dev siempre se invoca desde la raíz del repo, así que
// process.cwd() es estable en los dos modos.
import '../../estilos/tokens.css';
import '../../estilos/interfaz.css';
import AppInteractiva from '../../componentes/AppInteractiva.astro';
import { fusionarProvincias, UMBRAL_HIDRATACION_EMBEBIDA } from '../../logica/zona.ts';
import { calcularTablaZona, bandaPrecioZona, hrefMunicipioZona } from '../../logica/tablaZona.ts';
import { tituloZona, descripcionZona } from '../../logica/metaZona.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { cajaDeTitulo, formatearFechaHora, formatearPrecio } from '../../logica/formato.ts';
import type { DatosProvincia, Indice, Zona } from '../../../scripts/lib/tipos.ts';

const DIRECTORIO_DATOS = join(process.cwd(), 'public', 'data');

export async function getStaticPaths() {
  // Ruta calculada de nuevo aquí dentro, sin usar la constante de arriba:
  // Astro extrae `getStaticPaths` a su propio módulo para el build y no
  // arrastra con él las constantes del resto del frontmatter.
  const rutaIndice = join(process.cwd(), 'public', 'data', 'indice.json');
  const indice = JSON.parse(readFileSync(rutaIndice, 'utf-8')) as Indice;

  return indice.zonas.map((zona) => ({
    params: { zona: zona.id },
    props: { zona },
  }));
}

interface Props {
  zona: Zona;
}

const { zona } = Astro.props;

const titulo = tituloZona(zona.nombre);
const descripcion = descripcionZona(zona.nombre);
const canonical = new URL(`/${zona.id}/`, Astro.site);
// H11 (RF-66): la tarjeta la genera scripts/generar-imagenes-compartir.ts en
// el build, con el mismo id de zona que esta ruta. og:image tiene que ser
// una URL ABSOLUTA — WhatsApp no resuelve rutas relativas y el fallo es
// silencioso, así que se construye con Astro.site igual que `canonical`.
const imagenCompartir = new URL(`/og/${zona.id}.png`, Astro.site);

// RF-61: los precios tienen que estar en el HTML servido, no inyectados solo
// por JavaScript. Esto corre en Node durante el build (igual que
// getStaticPaths arriba): lee los ficheros de provincia de la zona del disco,
// sin red, y los fusiona con la misma función que usa el cliente al cambiar
// de zona (src/logica/zona.ts), para que las dos vías no diverjan.
const datosPorProvincia: DatosProvincia[] = zona.provincias.map((id) => {
  const ruta = join(DIRECTORIO_DATOS, 'provincias', `${id}.json`);
  return JSON.parse(readFileSync(ruta, 'utf-8')) as DatosProvincia;
});
const { estaciones, mock, actualizado } = fusionarProvincias(datosPorProvincia);

// --- Tabla estática, acotada (corrección tras medir la primera versión) ---
// Una tabla con las 2.000 y pico estaciones de una comunidad no posiciona
// mejor que una con 30: Google no premia el volcado exhaustivo, y esas filas
// de más hay que parsearlas en el móvil aunque el gzip las disimule. Aquí solo
// van las 30 más baratas con sus cuatro precios, más un resumen por
// municipio (RF-74: es lo que enlaza esta página con sus municipios). La
// tabla completa de una gasolinera por gasolinera vive en la página de SU
// municipio (H10, segunda mitad), donde sí son pocas y son el contenido
// entero de la página.
//
// Deliberadamente NO es la misma lista que hidrata la aplicación interactiva
// de más abajo: esa se pinta con el combustible por defecto porque el elegido
// de verdad vive en localStorage, que el build no puede leer, así que
// reordenarla al montar el cliente es inevitable. Esta tabla, en cambio, no
// depende de ningún combustible activo —enseña los cuatro a la vez— y no se
// pinta con JavaScript en la primera carga: la sirve el build. RF-88
// (ADR-0016) sí la regenera después, en cliente, si el usuario cambia de
// zona sin recargar — con este mismo cálculo, src/logica/tablaZona.ts, para
// que las dos vías no diverjan.
const { filas: filasTabla, multiProvincia: multiProvinciaTabla, escalas: escalasPorCombustible, resumenMunicipios } =
  calcularTablaZona(estaciones);

// Solo por debajo de UMBRAL_HIDRATACION_EMBEBIDA (ver el porqué en
// src/logica/zona.ts) va embebido el bloque de hidratación del widget
// interactivo; por encima, AppInteractiva pide los JSON de provincia por
// fetch, como antes de H10.
const hidratacionEmbebida = estaciones.length <= UMBRAL_HIDRATACION_EMBEBIDA;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16323B" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <AppInteractiva
      zonaId={zona.id}
      zonaNombre={zona.nombre}
      hidratacionEmbebida={hidratacionEmbebida}
      estaciones={estaciones}
      mock={mock}
      actualizado={actualizado}
      esPaginaDeZona={true}
    />

    <section id="tabla-zona" class="tabla-zona" aria-label={`Las más baratas y los municipios de ${zona.nombre}`}>
      <h2 class="tabla-zona__titulo">Las {filasTabla.length} más baratas de {zona.nombre}</h2>
      {actualizado && (
        <p class="tabla-zona__actualizado">Actualizado: {formatearFechaHora(actualizado)}.</p>
      )}
      <div class="tabla-zona__scroll">
        <table class="tabla-zona__tabla">
          <thead>
            <tr>
              <th scope="col">Gasolinera</th>
              <th scope="col">Dirección</th>
              <th scope="col">Municipio</th>
              {multiProvinciaTabla && <th scope="col">Provincia</th>}
              {ORDEN_COMBUSTIBLES.map((clave) => <th scope="col">{ETIQUETA[clave]}</th>)}
            </tr>
          </thead>
          <tbody>
            {filasTabla.map((estacion) => (
              <tr>
                <th scope="row">{estacion.rotulo}</th>
                <td>{cajaDeTitulo(estacion.direccion)}</td>
                <td>{cajaDeTitulo(estacion.municipio)}</td>
                {multiProvinciaTabla && <td>{estacion.provinciaNombre}</td>}
                {ORDEN_COMBUSTIBLES.map((clave) => {
                  const precio = estacion.precios[clave];
                  return (
                    <td>
                      {precio === null ? (
                        <span class="tabla-zona__ausente">no vende</span>
                      ) : (
                        <span class={`precio precio--${bandaPrecioZona(escalasPorCombustible, clave, precio)}`}>
                          {formatearPrecio(precio)}
                        </span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="tabla-zona__titulo tabla-zona__titulo--municipios">
        Precios por municipio en {zona.nombre}
      </h2>
      <div class="tabla-zona__scroll">
        <table class="tabla-zona__tabla">
          <thead>
            <tr>
              <th scope="col">Municipio</th>
              {multiProvinciaTabla && <th scope="col">Provincia</th>}
              <th scope="col">Estaciones</th>
              <th scope="col">Gasolina 95 desde</th>
            </tr>
          </thead>
          <tbody>
            {resumenMunicipios.map((resumen) => {
              const href = hrefMunicipioZona(resumen);
              return (
                <tr>
                  <th scope="row">
                    {href ? <a href={href}>{cajaDeTitulo(resumen.municipio)}</a> : cajaDeTitulo(resumen.municipio)}
                  </th>
                  {multiProvinciaTabla && <td>{resumen.provinciaNombre}</td>}
                  <td>{resumen.estaciones}</td>
                  <td>
                    {resumen.precioMinimo === null ? (
                      <span class="tabla-zona__ausente">no vende</span>
                    ) : (
                      <span class={`precio precio--${bandaPrecioZona(escalasPorCombustible, 'gasolina95e5', resumen.precioMinimo)}`}>
                        {formatearPrecio(resumen.precioMinimo)}
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </body>
</html>
