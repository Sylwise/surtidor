---
import SelectorCombustibleEditorial from '../../componentes/SelectorCombustibleEditorial.astro';
import TablaFiscalEditorial from '../../componentes/TablaFiscalEditorial.astro';
import DocumentoEditorial from '../../layouts/DocumentoEditorial.astro';
import { leerAgregadosEditoriales, type AgregadoZona } from '../../../scripts/lib/agregados.ts';
import { ordenarRanking } from '../../../scripts/lib/ranking.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES_COMPARABLES as ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { formatearFechaHora, formatearNumero, formatearPrecio, nombreVisible } from '../../logica/formato.ts';
import type { ClavePrecio } from '../../../scripts/lib/tipos.ts';

const ruta = '/hoy/canarias-ceuta-melilla/';
const titulo = 'Precio de la gasolina en Canarias, Ceuta y Melilla hoy · Surtidor';
const descripcion =
  'Precios medios de gasolina y diésel en Las Palmas, Santa Cruz de Tenerife, Ceuta y Melilla, separados por su fiscalidad.';
const agregados = await leerAgregadosEditoriales();
const provincias = agregados.zonas.canariasCeutaMelilla.filter(
  (zona) => zona.tipo === 'provincia',
);

function ranking(combustible: ClavePrecio) {
  return ordenarRanking(
    provincias,
    (provincia) => provincia.combustibles[combustible].media,
    (provincia) => provincia.nombre,
  );
}

const rankings = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const lideres = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [
    combustible,
    rankings[combustible].find(
      ({ elemento }) => elemento.combustibles[combustible].media !== null,
    )?.elemento ?? null,
  ]),
) as Record<ClavePrecio, AgregadoZona | null>;
const gasolina95 = ORDEN_COMBUSTIBLES[0];
const liderGasolina95 = lideres[gasolina95];
const resumenGasolina95 = liderGasolina95?.combustibles[gasolina95] ?? null;
---

<DocumentoEditorial titulo={titulo} descripcion={descripcion} ruta={ruta} imagenCompartir="/og/hoy/canarias-ceuta-melilla.png" actualizado={agregados.actualizado}>
  <div class="editorial-canarias editorial-pagina-ranking" data-editorial-ranking>
    <header class="editorial-canarias__hero">
      <div class="editorial-canarias__intro">
        <p class="editorial-eyebrow">Mercados fiscales · Precios de hoy</p>
        <h1 class="editorial-titulo">Gasolina y diésel en Canarias, Ceuta y Melilla</h1>
        <p class="editorial-entradilla">
          Cuatro territorios que se comparan por separado: aquí el precio también refleja un régimen fiscal distinto.
        </p>
      </div>
      {liderGasolina95 && resumenGasolina95 && (
        <article class="editorial-canarias__principal">
          <span>Gasolina 95 · Menor media</span>
          <strong>{resumenGasolina95.media === null ? 'sin datos' : `${formatearPrecio(resumenGasolina95.media)} €/L`}</strong>
          <a href={`/${liderGasolina95.id}/`}>{nombreVisible(liderGasolina95.nombre, 'provincia')}</a>
          <small>Media simple · {formatearNumero(resumenGasolina95.n)} {resumenGasolina95.n === 1 ? 'estación' : 'estaciones'}</small>
          <time datetime={agregados.actualizado}>Datos actualizados · {formatearFechaHora(agregados.actualizado)}</time>
        </article>
      )}
    </header>

    <section class="editorial-canarias__resumen" aria-label="Territorio con menor media por combustible">
      {ORDEN_COMBUSTIBLES.map((combustible) => {
        const lider = lideres[combustible];
        const resumen = lider?.combustibles[combustible] ?? null;
        return (
          <article class="editorial-canarias__tarjeta">
            <span>{ETIQUETA[combustible]}</span>
            <strong>{resumen?.media === null || !resumen ? 'sin datos' : `${formatearPrecio(resumen.media)} €/L`}</strong>
            {lider && resumen && <a href={`/${lider.id}/`}>{nombreVisible(lider.nombre, 'provincia')} · {formatearNumero(resumen.n)} est.</a>}
          </article>
        );
      })}
    </section>

    <section class="editorial-canarias__fiscal" aria-labelledby="por-que-separados">
      <div>
        <h2 id="por-que-separados">Por qué no entran en el ranking nacional</h2>
        <p>
          Canarias aplica un impuesto autonómico; Ceuta y Melilla aplican IPSI. Separarlos evita presentar como diferencia de mercado lo que también es una diferencia tributaria.
        </p>
      </div>
      <ul aria-label="Fuentes tributarias oficiales">
        <li><a href="https://www3.gobiernodecanarias.org/tributos/atc/w/combustibles-2">Agencia Tributaria Canaria</a></li>
        <li><a href="https://www.boe.es/eli/es/l/1991/03/25/8/con">Ley del IPSI de Ceuta y Melilla</a></li>
      </ul>
    </section>

    <SelectorCombustibleEditorial etiqueta="Clasificación por combustible" />
    <p class="sr-only" aria-live="polite" data-estado-selector></p>

    {ORDEN_COMBUSTIBLES.map((combustible, indiceCombustible) => {
      const filas = rankings[combustible];
      const lider = lideres[combustible];
      return (
        <section
          id={`panel-${combustible}`}
          class="editorial-canarias__panel"
          data-panel-combustible={combustible}
          hidden={indiceCombustible > 0}
          aria-labelledby={`titulo-${combustible}`}
        >
          <div class="editorial-canarias__ranking">
            <header class="editorial-canarias__ranking-cabecera">
              <span>
                <h2 id={`titulo-${combustible}`}>{ETIQUETA[combustible]}</h2>
                <small>Media por territorio · de menor a mayor</small>
              </span>
              <b>{formatearNumero(filas.length)} territorios</b>
            </header>
            <TablaFiscalEditorial filas={filas} combustible={combustible} />
          </div>

          <aside class="editorial-canarias__lateral">
            <article class="editorial-canarias__lectura">
              <span>Lectura rápida</span>
              <strong>{lider ? `${nombreVisible(lider.nombre, 'provincia')} tiene la menor media en ${ETIQUETA[combustible].toLocaleLowerCase('es')}.` : `No hay datos para ${ETIQUETA[combustible].toLocaleLowerCase('es')}.`}</strong>
            </article>
            <nav class="editorial-canarias__otras" aria-label="Otras clasificaciones" data-selector-editorial>
              <p>Otras clasificaciones</p>
              {ORDEN_COMBUSTIBLES.filter((otro) => otro !== combustible).map((otro) => {
                const otroLider = lideres[otro];
                const otroResumen = otroLider?.combustibles[otro] ?? null;
                return <button type="button" data-combustible={otro} aria-controls={`panel-${otro}`} aria-pressed="false">
                  <span><strong>{ETIQUETA[otro]}</strong><small>{otroLider && otroResumen ? `${nombreVisible(otroLider.nombre, 'provincia')} · ${formatearNumero(otroResumen.n)} est.` : 'Sin datos'}</small></span>
                  <b>{otroResumen?.media === null || !otroResumen ? '—' : `${formatearPrecio(otroResumen.media)} €/L`}</b>
                </button>;
              })}
            </nav>
            <div class="editorial-canarias__metodo-resumen">
              <strong>Media simple por estación</strong>
              <span>Solo estaciones que venden el combustible. Un valor ausente nunca cuenta como cero.</span>
            </div>
          </aside>

          <article class="editorial-canarias__lectura editorial-canarias__lectura--movil">
            <span>Lectura rápida</span>
            <strong>{lider ? `${nombreVisible(lider.nombre, 'provincia')} tiene la menor media en ${ETIQUETA[combustible].toLocaleLowerCase('es')}.` : `No hay datos para ${ETIQUETA[combustible].toLocaleLowerCase('es')}.`}</strong>
          </article>

          <details class="editorial-canarias__metodologia">
            <summary><span>Media simple · un valor ausente nunca es cero</span><strong>Cómo se calcula</strong></summary>
            <div>
              <p>Calculamos una media simple por estación, sin ponderar por volumen de venta porque ese dato no existe en la fuente. Una estación que no vende un combustible queda fuera de su media y nunca cuenta como cero. La columna «Estaciones» muestra la muestra exacta.</p>
              <p>Los precios se comparan con los tres decimales publicados por el ministerio. Los empates comparten posición y se ordenan alfabéticamente.</p>
            </div>
          </details>
        </section>
      );
    })}
  </div>
</DocumentoEditorial>
