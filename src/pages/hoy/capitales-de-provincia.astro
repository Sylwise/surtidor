---
import SelectorCombustibleEditorial from '../../componentes/SelectorCombustibleEditorial.astro';
import TablaCapitalesEditorial from '../../componentes/TablaCapitalesEditorial.astro';
import DocumentoEditorial from '../../layouts/DocumentoEditorial.astro';
import { leerAgregadosCapitales, type AgregadoCapital } from '../../../scripts/lib/capitales.ts';
import { ordenarRanking } from '../../../scripts/lib/ranking.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES_COMPARABLES as ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { formatearFechaHora, formatearNumero, formatearPrecio, nombreVisible } from '../../logica/formato.ts';
import type { ClavePrecio } from '../../../scripts/lib/tipos.ts';

const ruta = '/hoy/capitales-de-provincia/';
const titulo = 'Capitales de provincia con gasolina más barata hoy · Surtidor';
const descripcion = 'Ranking actualizado del precio medio de gasolina y diésel en las 52 capitales de provincia de España.';
const agregados = await leerAgregadosCapitales();

function ranking(capitales: AgregadoCapital[], combustible: ClavePrecio) {
  return ordenarRanking(capitales, (capital) => capital.combustibles[combustible].media, (capital) => capital.nombre);
}

const rankingsGenerales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(agregados.general, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const rankingsFiscales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(agregados.canariasCeutaMelilla, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const lideres = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [
    combustible,
    rankingsGenerales[combustible].find(({ elemento }) => elemento.combustibles[combustible].media !== null)?.elemento ?? null,
  ]),
) as Record<ClavePrecio, AgregadoCapital | null>;
---

<DocumentoEditorial titulo={titulo} descripcion={descripcion} ruta={ruta} imagenCompartir="/og/hoy/capitales-de-provincia.png">
  <div class="editorial-pagina-ranking" data-editorial-ranking>
    <header class="editorial-intro editorial-intro--ranking">
      <p class="editorial-eyebrow">Capitales · Media de hoy</p>
      <h1 class="editorial-titulo">En qué capitales cuesta menos repostar</h1>
      <p class="editorial-entradilla">Comparamos la media simple de las estaciones situadas en cada una de las 48 capitales del mercado general. Las otras cuatro capitales, las de Canarias, Ceuta y Melilla, tienen fiscalidad distinta y van en su propio bloque más abajo. El nombre de la ciudad abre directamente su mapa local.</p>
      <p class="editorial-actualizado">Datos actualizados <time datetime={agregados.actualizado}>{formatearFechaHora(agregados.actualizado)}</time>.</p>
      {ORDEN_COMBUSTIBLES.map((combustible, indice) => {
        const lider = lideres[combustible];
        const resumen = lider?.combustibles[combustible] ?? null;
        return <article class="editorial-destacado" data-destacado-combustible={combustible} hidden={indice > 0}>
          <span>Capital con menor media · {ETIQUETA[combustible]}</span>
          <strong>{resumen?.media === null || !resumen ? 'sin datos' : `${formatearPrecio(resumen.media)} €/L`}</strong>
          {lider && resumen && <div>
            <span>Capital</span>
            <a href={lider.href}>{nombreVisible(lider.nombre, 'municipio')}</a>
            <small>Media de {formatearNumero(resumen.n)} {resumen.n === 1 ? 'estación' : 'estaciones'}</small>
          </div>}
        </article>;
      })}
    </header>

    <SelectorCombustibleEditorial />
    <p class="sr-only" aria-live="polite" data-estado-selector></p>

    {ORDEN_COMBUSTIBLES.map((combustible, indiceCombustible) => {
      const filas = rankingsGenerales[combustible];
      const conDatos = filas.filter(({ elemento }) => elemento.combustibles[combustible].media !== null);
      const filasPrincipales = conDatos.slice(0, 8);
      return <section id={`panel-${combustible}`} class="editorial-panel-ranking" data-panel-combustible={combustible} hidden={indiceCombustible > 0} aria-labelledby={`titulo-capitales-${combustible}`}>
        <aside class="editorial-claves">
          <p class="micro">Cómo leer este ranking</p>
          <h2 id={`titulo-capitales-${combustible}`}>{ETIQUETA[combustible]}</h2>
          <p>Solo intervienen estaciones públicas que publican el combustible seleccionado.</p>
          <dl>
            <div><dt>Capitales del mercado general</dt><dd>{formatearNumero(filas.length)}</dd></div>
            <div><dt>Capitales con datos</dt><dd>{formatearNumero(conDatos.length)}</dd></div>
          </dl>
        </aside>

        <div class="editorial-ranking">
          <div class="editorial-ranking__cabecera"><span class="micro">Ranking de capitales · Top {filasPrincipales.length}</span><span>Media simple</span></div>
          {conDatos.length === 0 ? <section class="editorial-estado" role="status"><h3>Sin datos para {ETIQUETA[combustible]}</h3><p>Ninguna capital del mercado general publica este combustible hoy.</p></section> : <>
            <TablaCapitalesEditorial filas={filasPrincipales} combustible={combustible} principal />
            {conDatos.length > 6 && <details class="editorial-detalles editorial-detalles--ranking"><summary>Ver las {formatearNumero(filas.length)} capitales</summary><TablaCapitalesEditorial filas={conDatos.slice(6)} combustible={combustible} duplicadas={2} etiqueta={`Clasificación completa de ${ETIQUETA[combustible]}`} /></details>}
          </>}
        </div>

        <aside class="editorial-fiscal editorial-fiscal--compacta editorial-fiscal--tarjetas">
          <div><h3>Canarias, Ceuta y Melilla</h3></div>
          <ul class="editorial-fiscal__datos" aria-label={`${ETIQUETA[combustible]} en capitales de territorios fiscales`}>
            {rankingsFiscales[combustible].map(({ elemento: capital }) => {
              const resumen = capital.combustibles[combustible];
              return <li>
                <span>
                  <strong><a href={capital.href}>{nombreVisible(capital.nombre, 'municipio')}</a></strong>
                  <small>{formatearNumero(resumen.n)} {resumen.n === 1 ? 'estación' : 'estaciones'}</small>
                </span>
                <b>{resumen.media === null ? 'no vende' : `${formatearPrecio(resumen.media)} €/L`}</b>
              </li>;
            })}
          </ul>
        </aside>
        <details class="editorial-fiscal-movil">
          <summary>Canarias, Ceuta y Melilla</summary>
          <TablaCapitalesEditorial filas={rankingsFiscales[combustible]} combustible={combustible} etiqueta={`${ETIQUETA[combustible]} en capitales de territorios fiscales`} />
        </details>

        <details class="editorial-metodologia-final"><summary>Metodología y limitaciones</summary><p>Media aritmética simple por capital y combustible, sin ponderar por volumen de venta. Una estación que no vende el producto queda fuera y nunca cuenta como cero. Los nombres de las 52 capitales se validan literalmente durante el build.</p></details>
      </section>;
    })}
  </div>
</DocumentoEditorial>
