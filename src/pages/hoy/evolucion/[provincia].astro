---
import '../../../estilos/tokens.css';
import '../../../estilos/editorial.css';
import '../../../estilos/evolucion.css';
import CabeceraGlobal from '../../../componentes/CabeceraGlobal.astro';
import PieEditorial from '../../../componentes/PieEditorial.astro';
import '../../../estilos/navegacion-global.css';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Indice } from '../../../../scripts/lib/tipos.ts';
import { nombreVisible } from '../../../logica/formato.ts';

export function getStaticPaths() {
  const indice = JSON.parse(readFileSync(join(process.cwd(), 'public/data/indice.json'), 'utf8')) as Indice;
  return indice.provincias.map((provincia) => ({
    params: { provincia: provincia.id },
    props: {
      nombre: provincia.nombre,
      zonaId: indice.zonas.find((zona) => zona.tipo === 'provincia' && zona.provincias[0] === provincia.id)?.id ?? '',
      actualJson: readFileSync(join(process.cwd(), 'public/data/provincias', `${provincia.id}.json`), 'utf8').replace(/</g, '\\u003c'),
      historicoJson: readFileSync(join(process.cwd(), 'public/data/historico/provincias', `${provincia.id}.json`), 'utf8').replace(/</g, '\\u003c'),
    },
  }));
}
const provinciaId = Astro.params.provincia!;
const { nombre: nombreCrudo, zonaId, actualJson, historicoJson } = Astro.props as { nombre: string; zonaId: string; actualJson: string; historicoJson: string };
const nombre = nombreVisible(nombreCrudo, 'provincia');
const canonical = new URL(`/hoy/evolucion/${provinciaId}/`, Astro.site);
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <title>Evolución del precio en {nombre} · Surtidor</title>
    <meta name="description" content={`Qué está pasando con el precio del combustible en ${nombre} durante los últimos 90 días.`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#16323B" />
  </head>
  <body>
    <div class="evolucion-app" data-evolucion data-provincia-id={provinciaId}>
      <CabeceraGlobal modo="evolucion" variante="petroleo" provinciaId={provinciaId} zonaHref={`/${zonaId}/`} zonaNombre={nombre} contexto="Evolución">
        <button slot="accion-movil" class="evolucion-abrir-explorador" type="button" data-abrir-explorador aria-label="Explorar estaciones">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        </button>
      </CabeceraGlobal>

      <main class="evolucion-shell">
        <section class="evolucion-estado" data-estado role="status"><i aria-hidden="true"></i><span>Cargando histórico de {nombre}…</span></section>
        <div class="evolucion-workbench" data-contenido hidden>
          <aside class="evolucion-rail">
            <div class="evolucion-rail__cabecera"><span>Evolución</span><strong data-territorio-activo>{nombre}</strong><button type="button" data-volver-provincia hidden>Ver toda {nombre} →</button></div>
            <section class="evolucion-controles evolucion-controles--rail">
              <label>Combustible</label><div class="evolucion-combustibles" data-combustibles aria-label="Combustible"></div>
              <label>Periodo</label><div class="evolucion-periodos" aria-label="Periodo"><button data-periodo="1" aria-pressed="false">1 día</button><button data-periodo="7" aria-pressed="false">7 días</button><button data-periodo="30" aria-pressed="true">30 días</button><button data-periodo="90" aria-pressed="false">90 días</button></div>
            </section>
            <section class="evolucion-explorar">
              <header><h2>Explorar estaciones</h2><output data-busqueda-resumen hidden></output></header>
              <label class="evolucion-busqueda"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m16 16 5 5" /></svg><input type="search" data-buscar-estacion placeholder="Nombre, municipio o dirección" /><button type="button" data-limpiar-busqueda hidden aria-label="Limpiar búsqueda">×</button></label>
              <ul data-resultados-estacion></ul>
              <article data-detalle-estacion hidden><button type="button" data-cerrar-estacion>← Media provincial</button><h3 data-estacion-titulo></h3><p data-estacion-resumen></p></article>
            </section>
            <section class="evolucion-ranking" aria-labelledby="titulo-ranking">
              <header class="evolucion-ranking__cabecera">
                <h2 id="titulo-ranking">Cambios destacados</h2>
                <p data-contexto-cambios></p>
              </header>
              <ol data-cambios-destacados></ol>
              <button class="evolucion-ranking__observaciones" type="button" data-ver-observaciones>
                <span data-texto-observaciones></span>
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </button>
            </section>
          </aside>

          <article class="evolucion-canvas evolucion-panel">
            <section class="evolucion-controles evolucion-controles--movil">
              <p class="evolucion-contexto-movil"><b data-territorio-activo-movil>{nombre}</b><i aria-hidden="true">·</i><span>Evolución</span></p>
              <div class="evolucion-combustibles" data-combustibles role="group" aria-label="Combustible"></div>
              <div class="evolucion-periodos" role="group" aria-label="Periodo"><button data-periodo="1" aria-label="1 día" aria-pressed="false">1 d</button><button data-periodo="7" aria-label="7 días" aria-pressed="false">7 d</button><button data-periodo="30" aria-label="30 días" aria-pressed="true">30 d</button><button data-periodo="90" aria-label="90 días" aria-pressed="false">90 d</button></div>
            </section>

            <header class="evolucion-resumen">
              <div class="evolucion-resumen__titulo"><p data-ambito>Media provincial</p><h1 data-titulo-panel></h1></div>
              <div class="evolucion-panel__precio"><span data-etiqueta-precio>Último cierre</span><strong data-precio></strong></div>
              <p class="evolucion-conclusion"><b class="evolucion-cambio--desktop" data-cambio></b><b class="evolucion-cambio--movil" data-cambio-movil></b><span data-frase-desktop></span><span data-frase-movil></span></p>
              <p class="evolucion-contexto" data-contexto></p>
              <p class="evolucion-estabilidad" data-estabilidad hidden></p>
              <ol data-claves hidden></ol>
            </header>

            <dl class="evolucion-hitos">
              <div><dt data-etiqueta-media>Media</dt><dd data-media></dd></div>
              <div><dt data-etiqueta-minimo>Mínimo</dt><dd data-minimo></dd></div>
              <div><dt data-etiqueta-muestra>Estaciones</dt><dd data-muestra></dd></div>
            </dl>

            <section class="evolucion-comparacion" data-comparacion-estacion hidden>
              <div class="evolucion-comparacion__tarjeta"><div><h2 data-comparacion-nombre></h2><p data-comparacion-lugar></p><strong data-comparacion-precio></strong></div><div><span>Diferencia respecto a la media municipal</span><strong data-comparacion-diferencia></strong><small data-comparacion-deposito></small></div></div>
              <p class="evolucion-comparacion__aviso-escala" data-aviso-escala hidden></p>
              <dl class="evolucion-comparacion__barras"><div><dt>Esta estación</dt><dd><i data-barra-estacion></i></dd><b data-valor-estacion></b></div><div><dt>Media municipal</dt><dd><i data-barra-municipio></i></dd><b data-valor-municipio></b></div><div><dt>Media provincial</dt><dd><i data-barra-provincia></i></dd><b data-valor-provincia></b></div></dl>
            </section>

            <section class="evolucion-vacio" data-evolucion-vacio hidden>
              <h2 data-vacio-titulo></h2>
              <p data-vacio-texto></p>
              <button type="button" data-vacio-accion></button>
            </section>

            <section class="evolucion-grafico-card">
              <header><div><h2 data-titulo-grafico>Precio diario: media y mínimo provincial</h2><p data-rango-fechas></p></div><p class="evolucion-grafico-resumen-movil" data-resumen-grafico-movil></p><div class="evolucion-tramo"><span>Tramo más intenso</span><strong data-tramo></strong></div></header>
              <div class="evolucion-grafico-wrap"><svg class="evolucion-grafico" viewBox="0 0 900 360" role="img" aria-describedby="detalle-grafico-diario"></svg><output id="detalle-grafico-diario" class="evolucion-tooltip" data-tooltip hidden></output><p class="evolucion-grafico-instruccion">Desliza sobre la línea para cambiar de día</p></div>
              <div class="evolucion-leyenda"><span><i class="estacion"></i><b data-leyenda-principal>Media provincial</b></span><span><i class="provincia" data-muestra-leyenda-secundaria></i><b data-leyenda-secundaria>Precio mínimo</b></span><span data-leyenda-terciaria-contenedor hidden><i class="provincia"></i><b data-leyenda-terciaria>Media provincial</b></span></div>
            </section>

            <details class="evolucion-datos">
              <summary>Ver las 90 observaciones</summary>
              <div class="evolucion-datos__tabla-wrap">
                <table>
                  <caption class="sr-only">Observaciones diarias usadas en esta evolución</caption>
                  <thead><tr><th scope="col">Fecha</th><th scope="col" data-tabla-cabecera-principal>Serie principal</th><th scope="col" data-tabla-cabecera-secundaria>Comparación</th><th scope="col" data-tabla-cabecera-terciaria hidden>Provincia</th></tr></thead>
                  <tbody data-tabla-observaciones></tbody>
                </table>
              </div>
            </details>

            <section class="evolucion-movimientos-movil" aria-labelledby="titulo-cambios-movil">
              <header>
                <div><h2 id="titulo-cambios-movil">Cambios destacados</h2><p data-contexto-cambios></p></div>
                <button type="button" data-abrir-todas aria-label="Ver todas las estaciones"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg></button>
              </header>
              <ol data-cambios-destacados></ol>
            </section>
            <p class="evolucion-nota">Media simple de las estaciones que publicaron precio cada día. Los huecos no se interpolan.</p>
          </article>

          <div class="evolucion-sheet-fondo" data-sheet-fondo hidden></div>
          <section class="evolucion-sheet" data-sheet hidden aria-modal="true" role="dialog" aria-labelledby="titulo-sheet">
            <i class="evolucion-sheet__asa" aria-hidden="true"></i><header><div><h2 id="titulo-sheet">Todas las estaciones</h2><p data-sheet-contador></p></div><button type="button" data-cerrar-sheet aria-label="Cerrar lista de estaciones">✕</button></header>
            <label class="evolucion-busqueda"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m16 16 5 5" /></svg><input type="search" data-buscar-estacion-sheet placeholder="Nombre, municipio o dirección" /></label>
            <div class="evolucion-sheet__filtros"><button type="button" data-filtro-sheet="baratas" aria-pressed="true">Más baratas</button><button type="button" data-filtro-sheet="cercanas" aria-pressed="false">Cerca de mí</button><button type="button" data-filtro-sheet="abiertas" aria-pressed="false">Abiertas</button></div>
            <ol data-sheet-lista></ol>
          </section>
        </div>
      </main>
    </div>
    <PieEditorial />
    <script type="application/json" id="evolucion-actual" is:inline set:html={actualJson} />
    <script type="application/json" id="evolucion-historico" is:inline set:html={historicoJson} />
    <script>
      import { montarEvolucion } from '../../../componentes/Evolucion.ts';
      const raiz = document.querySelector<HTMLElement>('[data-evolucion]'); const provinciaId = raiz?.dataset.provinciaId;
      if (raiz && provinciaId) { const actual = JSON.parse(document.getElementById('evolucion-actual')?.textContent ?? 'null'); const historico = JSON.parse(document.getElementById('evolucion-historico')?.textContent ?? 'null'); await montarEvolucion(raiz, provinciaId, actual, historico); }
    </script>
  </body>
</html>
