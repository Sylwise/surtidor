---
import SelectorCombustibleEditorial from '../../componentes/SelectorCombustibleEditorial.astro';
import TablaMinimosEditorial from '../../componentes/TablaMinimosEditorial.astro';
import DocumentoEditorial from '../../layouts/DocumentoEditorial.astro';
import { leerAgregadosMinimos, type MinimosZona } from '../../../scripts/lib/minimos.ts';
import { ordenarRanking } from '../../../scripts/lib/ranking.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { formatearFechaHora, formatearNumero, formatearPrecio } from '../../logica/formato.ts';
import type { ClavePrecio } from '../../../scripts/lib/tipos.ts';

const ruta = '/hoy/la-mas-barata-de-espana/';
const titulo = 'La gasolina más barata de España hoy · Surtidor';
const descripcion = 'Dónde está hoy la gasolina y el diésel más baratos de España, con el mínimo de cada comunidad autónoma.';
const agregados = await leerAgregadosMinimos();

function ranking(zonas: MinimosZona[], combustible: ClavePrecio) {
  return ordenarRanking(zonas, (zona) => zona.combustibles[combustible].minimo, (zona) => zona.nombre);
}

const rankingsGenerales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(agregados.comunidades, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const rankingsFiscales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(agregados.canariasCeutaMelilla, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
---

<DocumentoEditorial titulo={titulo} descripcion={descripcion} ruta={ruta} imagenCompartir="/og/hoy/la-mas-barata-de-espana.png">
  <div class="editorial-pagina-ranking" data-editorial-ranking>
    <header class="editorial-intro editorial-intro--ranking">
      <p class="editorial-eyebrow">Mínimos · Precios de hoy</p>
      <h1 class="editorial-titulo">La estación más barata de España, hoy</h1>
      <p class="editorial-entradilla">Localizamos el menor precio publicado y lo situamos en su municipio. Si hay un empate exacto, mostramos todos los lugares que comparten el mínimo.</p>
      <p class="editorial-actualizado">Datos actualizados <time datetime={agregados.actualizado}>{formatearFechaHora(agregados.actualizado)}</time>.</p>
      {ORDEN_COMBUSTIBLES.map((combustible, indice) => {
        const resumen = agregados.nacional[combustible];
        return <article class="editorial-destacado editorial-destacado--minimo" data-destacado-combustible={combustible} hidden={indice > 0}>
          <span>Mínimo nacional · {ETIQUETA[combustible]}</span>
          <strong>{resumen.minimo === null ? 'sin datos' : `${formatearPrecio(resumen.minimo)} €/L`}</strong>
          <div>
            <span>{resumen.origenes.length === 1 ? 'Dónde' : `${resumen.origenes.length} municipios empatados`}</span>
            {resumen.origenes.map((origen) => <a href={origen.href}>{origen.municipio} · {origen.provinciaNombre}</a>)}
            <small>Entre {formatearNumero(resumen.n)} estaciones analizadas</small>
          </div>
        </article>;
      })}
    </header>

    <section class="editorial-resumen editorial-resumen--minimos" aria-label="Mínimos nacionales para los cuatro combustibles">
      {ORDEN_COMBUSTIBLES.map((combustible) => {
        const resumen = agregados.nacional[combustible];
        return <article class="editorial-tarjeta editorial-tarjeta--secundaria">
          <span class="editorial-tarjeta__combustible">{ETIQUETA[combustible]}</span>
          <strong class="editorial-tarjeta__precio">{resumen.minimo === null ? 'sin datos' : `${formatearPrecio(resumen.minimo)} €/L`}</strong>
          {resumen.origenes[0] && <a class="editorial-tarjeta__zona" href={resumen.origenes[0].href}>{resumen.origenes[0].municipio} · {resumen.origenes[0].provinciaNombre}{resumen.origenes.length > 1 && ` +${resumen.origenes.length - 1}`}</a>}
          <span class="editorial-tarjeta__muestra">Mínimo entre {formatearNumero(resumen.n)} estaciones</span>
        </article>;
      })}
    </section>

    <SelectorCombustibleEditorial />
    <p class="sr-only" aria-live="polite" data-estado-selector></p>

    {ORDEN_COMBUSTIBLES.map((combustible, indiceCombustible) => {
      const filas = rankingsGenerales[combustible];
      const conDatos = filas.filter(({ elemento }) => elemento.combustibles[combustible].minimo !== null);
      const filasPrincipales = conDatos.slice(0, 8);
      return <section id={`panel-${combustible}`} class="editorial-panel-ranking" data-panel-combustible={combustible} hidden={indiceCombustible > 0} aria-labelledby={`titulo-minimos-${combustible}`}>
        <aside class="editorial-claves">
          <p class="micro">Qué se compara</p>
          <h2 id={`titulo-minimos-${combustible}`}>{ETIQUETA[combustible]}</h2>
          <p>El mínimo de cada comunidad se obtiene entre estaciones públicas con un precio publicado.</p>
          <dl>
            <div><dt>Comunidades comparadas</dt><dd>{formatearNumero(filas.length)}</dd></div>
            {agregados.nacional[combustible].origenes.length > 1 && (
              <div><dt>Empate al mínimo nacional</dt><dd>{formatearNumero(agregados.nacional[combustible].origenes.length)} sitios</dd></div>
            )}
          </dl>
        </aside>

        <div class="editorial-ranking">
          <div class="editorial-ranking__cabecera"><span class="micro">Mínimo por comunidad · Top {filasPrincipales.length}</span><span>Precio publicado</span></div>
          {conDatos.length === 0 ? <section class="editorial-estado" role="status"><h3>Sin datos para {ETIQUETA[combustible]}</h3><p>Ninguna estación del mercado general publica este combustible hoy.</p></section> : <>
            <TablaMinimosEditorial filas={filasPrincipales} combustible={combustible} principal />
            {conDatos.length > 6 && <details class="editorial-detalles editorial-detalles--ranking"><summary>Ver las {formatearNumero(filas.length)} comunidades</summary><TablaMinimosEditorial filas={conDatos.slice(6)} combustible={combustible} duplicadas={2} etiqueta={`Clasificación completa de ${ETIQUETA[combustible]}`} /></details>}
          </>}
        </div>

        <aside class="editorial-fiscal editorial-fiscal--compacta editorial-fiscal--tarjetas">
          <div><h3>Canarias, Ceuta y Melilla</h3></div>
          <ul class="editorial-fiscal__datos" aria-label={`${ETIQUETA[combustible]} en territorios fiscales`}>
            {rankingsFiscales[combustible].map(({ elemento: zona }) => {
              const resumen = zona.combustibles[combustible];
              const origen = resumen.origenes[0];
              return <li>
                <span>
                  <strong><a href={`/${zona.id}/`}>{zona.nombre}</a></strong>
                  <small>{origen ? `${origen.municipio}${resumen.origenes.length > 1 ? ` +${resumen.origenes.length - 1}` : ''}` : 'Sin ubicación publicada'}</small>
                </span>
                <b>{resumen.minimo === null ? 'no vende' : `${formatearPrecio(resumen.minimo)} €/L`}</b>
              </li>;
            })}
          </ul>
        </aside>
        <details class="editorial-fiscal-movil">
          <summary>Canarias, Ceuta y Melilla</summary>
          <TablaMinimosEditorial filas={rankingsFiscales[combustible]} combustible={combustible} etiqueta={`${ETIQUETA[combustible]} en territorios fiscales`} />
        </details>

        <details class="editorial-metodologia-final"><summary>Metodología y limitaciones</summary><p>Se toma el menor precio publicado por una estación pública. Los valores ausentes se excluyen y los empates exactos a tres decimales se conservan. Si un municipio no tiene página propia por tamaño de muestra, el enlace conduce a su provincia y mantiene visible el municipio de origen.</p></details>
      </section>;
    })}
  </div>
</DocumentoEditorial>
