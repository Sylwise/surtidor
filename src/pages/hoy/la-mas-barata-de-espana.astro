---
import TablaMinimosEditorial from '../../componentes/TablaMinimosEditorial.astro';
import DocumentoEditorial from '../../layouts/DocumentoEditorial.astro';
import { leerAgregadosMinimos, type MinimosZona } from '../../../scripts/lib/minimos.ts';
import { ordenarRanking } from '../../../scripts/lib/ranking.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { formatearFechaHora, formatearPrecio } from '../../logica/formato.ts';
import type { ClavePrecio } from '../../../scripts/lib/tipos.ts';

const ruta = '/hoy/la-mas-barata-de-espana/';
const titulo = 'La gasolina más barata de España hoy · Surtidor';
const descripcion =
  'Dónde está hoy la gasolina y el diésel más baratos de España, con el mínimo de cada comunidad autónoma.';
const agregados = await leerAgregadosMinimos();

function ranking(zonas: MinimosZona[], combustible: ClavePrecio) {
  return ordenarRanking(
    zonas,
    (zona) => zona.combustibles[combustible].minimo,
    (zona) => zona.nombre,
  );
}

const rankingsGenerales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(agregados.comunidades, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const rankingsFiscales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [
    combustible,
    ranking(agregados.canariasCeutaMelilla, combustible),
  ]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
---

<DocumentoEditorial titulo={titulo} descripcion={descripcion} ruta={ruta} imagenCompartir="/og/hoy/la-mas-barata-de-espana.png">
  <header class="editorial-intro">
    <p class="editorial-eyebrow">Precios de hoy</p>
    <h1 class="editorial-titulo">Dónde está el combustible más barato de España</h1>
    <p class="editorial-entradilla">
      Localizamos el precio mínimo nacional y el de cada comunidad autónoma. Cada cifra enlaza al
      municipio donde se publica para que puedas consultar sus estaciones.
    </p>
    <p class="editorial-actualizado">
      Datos actualizados <time datetime={agregados.actualizado}>{formatearFechaHora(agregados.actualizado)}</time>.
    </p>
  </header>

  <section class="editorial-resumen" aria-label="Precio mínimo nacional por combustible">
    {ORDEN_COMBUSTIBLES.map((combustible, indice) => {
      const resumen = agregados.nacional[combustible];
      return (
        <article class:list={['editorial-tarjeta', { 'editorial-tarjeta--secundaria': indice > 1 }]}>
          <span class="editorial-tarjeta__combustible">{ETIQUETA[combustible]}</span>
          <strong class="editorial-tarjeta__precio">
            {resumen.minimo === null ? 'sin datos' : `${formatearPrecio(resumen.minimo)} €/L`}
          </strong>
          {resumen.origenes.map((origen) => (
            <a class="editorial-tarjeta__zona" href={origen.href}>
              {origen.municipio}
              {origen.destino === 'provincia' && ` · ${origen.provinciaNombre}`}
            </a>
          ))}
          <span class="editorial-tarjeta__muestra">
            Mínimo entre {resumen.n} {resumen.n === 1 ? 'estación' : 'estaciones'}
          </span>
        </article>
      );
    })}
  </section>

  <section class="editorial-metodo" aria-label="Metodología">
    <p class="editorial-metodo__resumen">
      <strong>Precio mínimo publicado</strong> · solo estaciones públicas que venden el combustible
      · municipio de origen visible.
    </p>
    <details class="editorial-detalles editorial-detalles--metodo">
      <summary>Cómo se calcula</summary>
      <div class="editorial-detalles__contenido">
        <p>
          Buscamos el menor precio publicado entre las estaciones públicas que venden cada
          combustible. La muestra indica cuántas estaciones participan en la comparación. Una
          estación sin ese producto queda fuera y nunca cuenta como cero.
        </p>
        <p>
          Si varias estaciones de municipios distintos publican el mismo mínimo con los tres
          decimales del ministerio, se muestran todos los municipios empatados. No existe una URL de
          estación: el enlace lleva a la página municipal que contiene el precio de origen. Si esa
          página no existe por el umbral mínimo de estaciones, lleva a la provincia que contiene la
          estación sin ocultar el nombre del municipio.
        </p>
        <p>
          Canarias, Ceuta y Melilla se presentan aparte porque su fiscalidad de carburantes es
          distinta. No se comparan como si fueran el mercado nacional más barato.
        </p>
      </div>
    </details>
  </section>

  {ORDEN_COMBUSTIBLES.map((combustible) => (
    <section class="editorial-combustible" id={combustible}>
      <h2>{ETIQUETA[combustible]}</h2>
      <p>Precio mínimo de cada comunidad autónoma, de menor a mayor.</p>

      <TablaMinimosEditorial
        filas={rankingsGenerales[combustible]}
        combustible={combustible}
      />

      <aside class="editorial-fiscal" aria-label={`${ETIQUETA[combustible]} en Canarias, Ceuta y Melilla`}>
        <h3>Canarias, Ceuta y Melilla</h3>
        <p>Resultados separados por su régimen fiscal distinto en los carburantes.</p>
        <TablaMinimosEditorial
          filas={rankingsFiscales[combustible]}
          combustible={combustible}
        />
      </aside>
    </section>
  ))}
</DocumentoEditorial>
