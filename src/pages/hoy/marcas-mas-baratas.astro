---
import SelectorCombustibleEditorial from '../../componentes/SelectorCombustibleEditorial.astro';
import TablaRotulosEditorial from '../../componentes/TablaRotulosEditorial.astro';
import DocumentoEditorial from '../../layouts/DocumentoEditorial.astro';
import { leerAgregadosEditoriales, type AgregadoRotulo } from '../../../scripts/lib/agregados.ts';
import { ordenarRanking } from '../../../scripts/lib/ranking.ts';
import { rotulosQueVenden, seleccionarMercadosFiscales, seleccionarRotulos, UMBRAL_ESTACIONES_ROTULO } from '../../../scripts/lib/rotulos.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { formatearFechaHora, formatearNumero, formatearPrecio } from '../../logica/formato.ts';
import type { ClavePrecio } from '../../../scripts/lib/tipos.ts';

const ruta = '/hoy/marcas-mas-baratas/';
const titulo = 'Marcas de gasolineras más baratas de España hoy · Surtidor';
const descripcion = 'Precio medio por rótulo en península y Baleares, con un mínimo de 100 estaciones y desglose fiscal separado.';
const agregados = await leerAgregadosEditoriales();
const seleccion = seleccionarRotulos(agregados.rotulos.general);
const mercadosFiscales = seleccionarMercadosFiscales(agregados.rotulos.mercadosFiscales);

function ranking(rotulos: readonly AgregadoRotulo[], combustible: ClavePrecio) {
  return ordenarRanking(
    rotulosQueVenden(rotulos, combustible),
    (rotulo) => rotulo.combustibles[combustible].media,
    (rotulo) => rotulo.rotulo,
  );
}

const rankingsGenerales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(seleccion.incluidos, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const lideres = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, rankingsGenerales[combustible][0]?.elemento ?? null]),
) as Record<ClavePrecio, AgregadoRotulo | null>;
---

<DocumentoEditorial titulo={titulo} descripcion={descripcion} ruta={ruta} imagenCompartir="/og/hoy/marcas-mas-baratas.png">
  <div class="editorial-pagina-ranking" data-editorial-ranking>
    <header class="editorial-intro editorial-intro--ranking">
      <p class="editorial-eyebrow">Rótulos · Precios de hoy</p>
      <h1 class="editorial-titulo">Qué marcas tienen los precios medios más bajos</h1>
      <p class="editorial-entradilla">Comparamos el nombre visible en el cartel, no la empresa propietaria. El ámbito general es península y Baleares.</p>
      <p class="editorial-actualizado">Datos actualizados <time datetime={agregados.actualizado}>{formatearFechaHora(agregados.actualizado)}</time>.</p>
      {ORDEN_COMBUSTIBLES.map((combustible, indice) => {
        const lider = lideres[combustible]; const resumen = lider?.combustibles[combustible];
        return <article class="editorial-destacado" data-destacado-combustible={combustible} hidden={indice > 0}>
          <span>Menor media · {ETIQUETA[combustible]}</span>
          <strong>{resumen?.media === null || !resumen ? 'sin datos' : `${formatearPrecio(resumen.media)} €/L`}</strong>
          {lider && resumen && <div>
            <span>Marca</span>
            <b class="editorial-destacado__entidad">{lider.rotulo}</b>
            <small>{formatearNumero(resumen.n)} estaciones con precio</small>
          </div>}
        </article>;
      })}
    </header>

    <section class="editorial-umbral" aria-label="Criterio de inclusión">
      <div><strong>Una clasificación con muestra mínima</strong><span>Solo entran rótulos con presencia suficiente en el mercado analizado.</span></div>
      <b>≥ {UMBRAL_ESTACIONES_ROTULO} estaciones</b>
    </section>

    <SelectorCombustibleEditorial />
    <p class="sr-only" aria-live="polite" data-estado-selector></p>

    {ORDEN_COMBUSTIBLES.map((combustible, indiceCombustible) => {
      const filas = rankingsGenerales[combustible];
      const filasPrincipales = filas.slice(0, 8);
      const resumenFiscal = mercadosFiscales.map((mercado) => {
        // Cada mercado fiscal usa un umbral proporcional a su tamaño. Conserva
        // una muestra mínima sin exigir a Ceuta, Melilla o Canarias el volumen
        // absoluto del mercado peninsular.
        const referencia = ranking(mercado.seleccion.incluidos, combustible)[0] ?? null;
        return {
          mercado,
          referencia,
          resumen: referencia?.elemento.combustibles[combustible] ?? null,
        };
      });
      return <section id={`panel-${combustible}`} class="editorial-panel-ranking" data-panel-combustible={combustible} hidden={indiceCombustible > 0} aria-labelledby={`titulo-marcas-${combustible}`}>
        <aside class="editorial-claves">
          <p class="micro">Cobertura del ranking</p>
          <h2 id={`titulo-marcas-${combustible}`}>{formatearNumero(filas.length)} rótulos</h2>
          <p>Los nombres se agrupan por coincidencia literal tras recortar espacios exteriores.</p>
          <dl>
            <div><dt>Estaciones analizadas</dt><dd>{formatearNumero(seleccion.estacionesTotales)}</dd></div>
            <div><dt>Fuera por muestra</dt><dd>{formatearNumero(seleccion.estacionesFuera)}</dd></div>
          </dl>
        </aside>

        <div class="editorial-ranking">
          <div class="editorial-ranking__cabecera"><span class="micro">Ranking de rótulos · Top {filasPrincipales.length}</span><span>{ETIQUETA[combustible]}</span></div>
          {filas.length === 0 ? <section class="editorial-estado" role="status"><h3>Sin rótulos con muestra suficiente</h3><p>Ningún rótulo que supera el umbral publica {ETIQUETA[combustible].toLowerCase()} hoy.</p></section> : <>
            <TablaRotulosEditorial filas={filasPrincipales} combustible={combustible} principal />
            {filas.length > 6 && <details class="editorial-detalles editorial-detalles--ranking"><summary>Ver los {formatearNumero(filas.length)} rótulos</summary><TablaRotulosEditorial filas={filas.slice(6)} combustible={combustible} etiqueta={`Clasificación completa de ${ETIQUETA[combustible]}`} /></details>}
          </>}
        </div>

        <aside class="editorial-fiscal editorial-fiscal--compacta editorial-fiscal--tarjetas">
          <div><h3>Canarias, Ceuta y Melilla</h3><p>Referencias locales con un umbral adaptado al tamaño de cada mercado.</p></div>
          <ul class="editorial-fiscal__datos">
            {resumenFiscal.map(({ mercado, referencia, resumen }) => (
              <li>
                <span>
                  <strong>{mercado.nombre}</strong>
                  <small>
                    {referencia && resumen
                      ? <>{referencia.elemento.rotulo} · {formatearNumero(resumen.n)} {resumen.n === 1 ? 'estación' : 'estaciones'} con precio</>
                      : `Ningún rótulo con la muestra local publica este combustible hoy`}
                  </small>
                  <small class="editorial-fiscal__umbral">Mínimo local: {formatearNumero(mercado.umbral)} estaciones</small>
                </span>
                <b>{resumen?.media === null || !resumen ? 'muestra insuficiente' : `${formatearPrecio(resumen.media)} €/L`}</b>
              </li>
            ))}
          </ul>
        </aside>
        <details class="editorial-fiscal-movil editorial-fiscal-movil--rotulos">
          <summary data-abrir-desglose>Canarias, Ceuta y Melilla · referencias locales</summary>
          <ul class="editorial-fiscal__datos">
            {resumenFiscal.map(({ mercado, referencia, resumen }) => (
              <li>
                <span>
                  <strong>{mercado.nombre}</strong>
                  <small>
                    {referencia && resumen
                      ? <>{referencia.elemento.rotulo} · {formatearNumero(resumen.n)} {resumen.n === 1 ? 'estación' : 'estaciones'} con precio</>
                      : `Ningún rótulo con la muestra local publica este combustible hoy`}
                  </small>
                  <small class="editorial-fiscal__umbral">Mínimo local: {formatearNumero(mercado.umbral)} estaciones</small>
                </span>
                <b>{resumen?.media === null || !resumen ? 'muestra insuficiente' : `${formatearPrecio(resumen.media)} €/L`}</b>
              </li>
            ))}
          </ul>
        </details>

        <details class="editorial-metodologia-final"><summary>Metodología y limitaciones</summary><p>Media simple por estación pública y combustible. CEPSA/MOEVE y REPSOL/CAMPSA/PETRONOR permanecen separados cuando el rótulo visible es distinto. Los valores ausentes no entran en el divisor.</p></details>
      </section>;
    })}

  </div>
</DocumentoEditorial>
