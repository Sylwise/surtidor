---
import SelectorCombustibleEditorial from '../../componentes/SelectorCombustibleEditorial.astro';
import TablaFiscalEditorial from '../../componentes/TablaFiscalEditorial.astro';
import DocumentoEditorial from '../../layouts/DocumentoEditorial.astro';
import { leerAgregadosEditoriales, type AgregadoZona } from '../../../scripts/lib/agregados.ts';
import { ordenarRanking } from '../../../scripts/lib/ranking.ts';
import { ETIQUETA, ORDEN_COMBUSTIBLES } from '../../logica/combustibles.ts';
import { formatearFechaHora, formatearPrecio } from '../../logica/formato.ts';
import type { ClavePrecio } from '../../../scripts/lib/tipos.ts';

const ruta = '/hoy/provincias-mas-baratas/';
const titulo = 'Provincias más baratas de España hoy · Surtidor';
const descripcion = 'Ranking actualizado de precios medios por provincia para los cuatro combustibles principales.';
const agregados = await leerAgregadosEditoriales();
const provinciasGenerales = agregados.zonas.general.filter((zona) => zona.tipo === 'provincia');
const provinciasFiscales = agregados.zonas.canariasCeutaMelilla.filter((zona) => zona.tipo === 'provincia');

function ranking(provincias: AgregadoZona[], combustible: ClavePrecio) {
  return ordenarRanking(
    provincias,
    (provincia) => provincia.combustibles[combustible].media,
    (provincia) => provincia.nombre,
  );
}

const rankingsGenerales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(provinciasGenerales, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const rankingsFiscales = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [combustible, ranking(provinciasFiscales, combustible)]),
) as Record<ClavePrecio, ReturnType<typeof ranking>>;
const lideres = Object.fromEntries(
  ORDEN_COMBUSTIBLES.map((combustible) => [
    combustible,
    rankingsGenerales[combustible].find(({ elemento }) => elemento.combustibles[combustible].media !== null)?.elemento ?? null,
  ]),
) as Record<ClavePrecio, AgregadoZona | null>;
---

<DocumentoEditorial titulo={titulo} descripcion={descripcion} ruta={ruta} imagenCompartir="/og/hoy/provincias-mas-baratas.png">
  <div class="editorial-pagina-ranking" data-editorial-ranking>
    <header class="editorial-intro editorial-intro--ranking">
      <p class="editorial-eyebrow">Precio de hoy · Media provincial</p>
      <h1 class="editorial-titulo">Dónde es más barato repostar de media</h1>
      <p class="editorial-entradilla">
        Comparamos la media simple de las estaciones de cada provincia. Una estación sin el combustible elegido queda fuera del cálculo: nunca cuenta como cero.
      </p>
      <p class="editorial-actualizado">
        Datos actualizados <time datetime={agregados.actualizado}>{formatearFechaHora(agregados.actualizado)}</time>.
      </p>
      {ORDEN_COMBUSTIBLES.map((combustible, indice) => {
        const lider = lideres[combustible];
        const resumen = lider?.combustibles[combustible] ?? null;
        return (
          <article class="editorial-destacado" data-destacado-combustible={combustible} hidden={indice > 0}>
            <span>Menor media · {ETIQUETA[combustible]}</span>
            <strong>{resumen?.media === null || !resumen ? 'sin datos' : `${formatearPrecio(resumen.media)} €/L`}</strong>
            {lider && resumen && <div>
              <span>Provincia</span>
              <a href={`/${lider.id}/`}>{lider.nombre}</a>
              <small>Media de {resumen.n} {resumen.n === 1 ? 'estación' : 'estaciones'}</small>
            </div>}
          </article>
        );
      })}
    </header>

    <SelectorCombustibleEditorial />
    <p class="sr-only" aria-live="polite" data-estado-selector></p>

    {ORDEN_COMBUSTIBLES.map((combustible, indiceCombustible) => {
      const filas = rankingsGenerales[combustible];
      const conDatos = filas.filter(({ elemento }) => elemento.combustibles[combustible].media !== null);
      const filasPrincipales = conDatos.slice(0, 8);
      return (
        <section
          id={`panel-${combustible}`}
          class="editorial-panel-ranking"
          data-panel-combustible={combustible}
          hidden={indiceCombustible > 0}
          aria-labelledby={`titulo-${combustible}`}
        >
          <aside class="editorial-claves">
            <p class="micro">Cómo leer este ranking</p>
            <h2 id={`titulo-${combustible}`}>{ETIQUETA[combustible]}</h2>
            <p>La media es simple y solo incluye estaciones públicas que publican este combustible.</p>
            <dl>
              <div><dt>Provincias comparadas</dt><dd>{filas.length}</dd></div>
              <div><dt>Mercado general</dt><dd>Península y Baleares</dd></div>
            </dl>
          </aside>

          <div class="editorial-ranking">
            <div class="editorial-ranking__cabecera">
              <span class="micro">Ranking provincial · Top {filasPrincipales.length}</span>
              <span>{conDatos.length} con datos</span>
            </div>
            {conDatos.length === 0 ? (
              <section class="editorial-estado" role="status">
                <h3>Sin datos para {ETIQUETA[combustible]}</h3>
                <p>Ninguna provincia del mercado general publica este combustible hoy.</p>
              </section>
            ) : (
              <>
                <div class="editorial-tabla-wrap">
                  <table class="editorial-tabla editorial-tabla--principal">
                    <thead><tr><th scope="col" class="editorial-tabla__posicion">Pos.</th><th scope="col">Provincia</th><th scope="col" class="editorial-tabla__numero">Media</th><th scope="col" class="editorial-tabla__numero">Estaciones</th></tr></thead>
                    <tbody>
                      {filasPrincipales.map(({ elemento: provincia, posicion }) => {
                        const resumen = provincia.combustibles[combustible];
                        return <tr><td class="editorial-tabla__posicion">{posicion}</td><td class="editorial-tabla__zona"><a href={`/${provincia.id}/`}>{provincia.nombre}</a></td><td class="editorial-tabla__numero editorial-tabla__media">{formatearPrecio(resumen.media!)} €/L</td><td class="editorial-tabla__numero editorial-tabla__estaciones">{resumen.n}<span class="editorial-tabla__unidad"> {resumen.n === 1 ? 'estación' : 'estaciones'}</span></td></tr>;
                      })}
                    </tbody>
                  </table>
                </div>
                {conDatos.length > 6 && (
                  <details class="editorial-detalles editorial-detalles--ranking">
                    <summary>Ver las {filas.length} provincias</summary>
                    <div class="editorial-tabla-wrap">
                      <table class="editorial-tabla" aria-label={`Clasificación completa de ${ETIQUETA[combustible]}`}>
                        <thead><tr><th scope="col" class="editorial-tabla__posicion">Pos.</th><th scope="col">Provincia</th><th scope="col" class="editorial-tabla__numero">Media</th><th scope="col" class="editorial-tabla__numero">Estaciones</th></tr></thead>
                        <tbody>
                          {conDatos.slice(6).map(({ elemento: provincia, posicion }, indice) => {
                            const resumen = provincia.combustibles[combustible];
                            return <tr class:list={{ 'editorial-continuacion__duplicada': indice < 2 }}><td class="editorial-tabla__posicion">{posicion}</td><td class="editorial-tabla__zona"><a href={`/${provincia.id}/`}>{provincia.nombre}</a></td><td class="editorial-tabla__numero editorial-tabla__media">{formatearPrecio(resumen.media!)} €/L</td><td class="editorial-tabla__numero editorial-tabla__estaciones">{resumen.n}<span class="editorial-tabla__unidad"> {resumen.n === 1 ? 'estación' : 'estaciones'}</span></td></tr>;
                          })}
                        </tbody>
                      </table>
                    </div>
                  </details>
                )}
              </>
            )}
          </div>

          <aside class="editorial-fiscal editorial-fiscal--compacta editorial-fiscal--tarjetas">
            <div><h3>Canarias, Ceuta y Melilla</h3></div>
            <ul class="editorial-fiscal__datos" aria-label={`${ETIQUETA[combustible]} en territorios fiscales`}>
              {rankingsFiscales[combustible].map(({ elemento: provincia }) => {
                const resumen = provincia.combustibles[combustible];
                return <li>
                  <span>
                    <strong><a href={`/${provincia.id}/`}>{provincia.nombre}</a></strong>
                    <small>{resumen.n} {resumen.n === 1 ? 'estación' : 'estaciones'}</small>
                  </span>
                  <b>{resumen.media === null ? 'no vende' : `${formatearPrecio(resumen.media)} €/L`}</b>
                </li>;
              })}
            </ul>
          </aside>
          <details class="editorial-fiscal-movil">
            <summary>Canarias, Ceuta y Melilla</summary>
            <TablaFiscalEditorial filas={rankingsFiscales[combustible]} combustible={combustible} />
          </details>

          <details class="editorial-metodologia-final">
            <summary>Metodología y limitaciones</summary>
            <p>Media aritmética simple por provincia y combustible. Se excluyen estaciones no públicas y valores ausentes. El tamaño de muestra aparece en cada fila.</p>
          </details>
        </section>
      );
    })}
  </div>
</DocumentoEditorial>
