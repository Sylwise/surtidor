---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../estilos/tokens.css';
import '../estilos/interfaz.css';
import marcaSvg from '../assets/marca.svg?raw';
import { ETIQUETA_TIPO, ORDEN_TIPOS } from '../componentes/Controles.ts';
import type { Indice } from '../../scripts/lib/tipos.ts';

const titulo = 'Surtidor · Precios de carburantes de España';
const descripcion = 'Precios de gasolina y diésel por zona, sin anuncios ni registro.';

// RF-91 (ADR-0017): la portada enlaza de verdad, en el HTML servido, a las
// 52 provincias y las 19 comunidades autónomas — si no, las 1.162 páginas
// del sitio solo se descubren por el sitemap y no reciben autoridad de
// enlace. Se lee del disco en el build, como ya hace getStaticPaths de
// src/pages/[...zona]/index.astro; no hay red aquí. Sin precio (RF-91, punto
// 4): la portada no carga datos de ninguna provincia, y un precio de una
// gasolinera a 500 km sería engañoso (ver el comentario de imagenCompartir,
// más abajo).
const indice = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'indice.json'), 'utf-8'),
) as Indice;
const zonasOrdenadas = [...indice.zonas].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const editoriales = [
  { href: '/hoy/provincias-mas-baratas/', nombre: 'Provincias más baratas de España hoy' },
  { href: '/hoy/cuanto-te-juegas/', nombre: 'Cuánto puedes ahorrar al llenar el depósito' },
  { href: '/hoy/marcas-mas-baratas/', nombre: 'Marcas de gasolineras más baratas de España' },
];
// La portada no tiene zona fija en el build (RF-49: se resuelve en el
// cliente) y, sobre todo, un precio de una gasolinera a 500 km sería
// engañoso en una página que no habla de ningún sitio concreto. Usa la
// tarjeta genérica —marca y promesa, sin datos que puedan caducar— que
// también usa el 404 y cualquier página que no sea de zona ni de municipio:
// es la imagen por defecto, no un caso especial de la raíz (ver
// scripts/generar-imagenes-compartir.ts#renderizarSvgPredeterminada). URL
// ABSOLUTA: WhatsApp no resuelve relativas.
const imagenCompartir = new URL('/og/predeterminada.png', Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16323B" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="app">
      <header class="cabecera">
        <span class="marca">
          <span class="marca__icono" aria-hidden="true" set:html={marcaSvg} />
          <span class="marca__texto">Surtidor</span>
        </span>
        <div id="controles-identidad" class="controles-identidad" aria-label="Zona"></div>
        <span id="insignia-mock" class="insignia-mock" hidden>Datos de prueba</span>
      </header>

      <div id="avisos" class="avisos" role="status" aria-live="polite"></div>

      <div class="layout">
        <!-- ADR-0006: en escritorio, barra lateral fija de siempre (a la
             izquierda, como en el diseño original). En móvil, hoja
             arrastrable con tres estados sobre el mapa (interfaz.css +
             src/componentes/Hoja.ts); el orden en el DOM deja de importar
             porque ambas pasan a position:fixed. -->
        <aside class="hoja" id="hoja" data-estado="media">
          <button type="button" class="hoja__asa" id="hoja-asa" aria-label="Panel de estaciones. Flecha arriba o abajo para cambiar de tamaño."></button>
          <div id="controles-rapidos" class="hoja__rapidos" aria-label="Combustible"></div>
          <div class="hoja__cuerpo">
            <section id="totem" class="totem" aria-label="Ficha de la estación seleccionada"></section>
            <section id="lista" class="lista" aria-label="Lista de estaciones"></section>
          </div>
        </aside>

        <div id="mapa" class="mapa-hueco">
          <p>Cargando mapa…</p>
        </div>
      </div>
    </div>

    <section class="enlaces-territorio" aria-label="Todas las provincias y comunidades autónomas">
      <div class="enlaces-bloque">
        <h2 class="enlaces-bloque__titulo micro">HOY</h2>
        <ul class="enlaces-bloque__filas">
          {editoriales.map((editorial) => (
            <li>
              <a href={editorial.href} class="enlaces-bloque__fila">
                <span class="enlaces-bloque__info">
                  <span class="enlaces-bloque__nombre">{editorial.nombre}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      {ORDEN_TIPOS.map((tipo) => {
        const deEsteTipo = zonasOrdenadas.filter((zona) => zona.tipo === tipo);
        if (deEsteTipo.length === 0) return null;
        return (
          <div class="enlaces-bloque">
            <h2 class="enlaces-bloque__titulo micro">{ETIQUETA_TIPO[tipo]}</h2>
            <ul class="enlaces-bloque__filas">
              {deEsteTipo.map((zona) => (
                <li>
                  {/* RF-76: el nombre del catálogo del ministerio, verbatim. */}
                  <a href={`/${zona.id}/`} class="enlaces-bloque__fila">
                    <span class="enlaces-bloque__info">
                      <span class="enlaces-bloque__nombre">{zona.nombre}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>

    <script>
      // Orquestación de la página: carga el índice, monta los componentes y
      // mantiene la zona activa al día.
      import { actualizarEstado, obtenerEstado, suscribir, type EstadoApp } from '../logica/estado.ts';
      import { cargarIndice, cargarZona, zonaDeReserva, zonaDeProvincia, provinciaMasCercana } from '../logica/zona.ts';
      import { montarControles } from '../componentes/Controles.ts';
      import { montarLista } from '../componentes/Lista.ts';
      import { montarTotem } from '../componentes/Totem.ts';
      import { montarHoja } from '../componentes/Hoja.ts';
      import { datosDesactualizados } from '../logica/frescura.ts';
      import type { FalloProvincia } from '../logica/zona.ts';
      import type { Indice } from '../../scripts/lib/tipos.ts';

      // RF-35: si ya hay una zona guardada de una visita anterior, esto ya
      // no es la portada: es la página de esa zona, con su HTML, su
      // JSON-LD y su og:image propios (src/pages/[...zona]/index.astro). Antes
      // esto se resolvía en sitio (el resto de este script cargaba la zona
      // sobre la marcha) y la URL se quedaba en "/" para siempre: compartir
      // ese enlace mandaba a quien lo abriera a SU zona guardada, no a la
      // que se estaba viendo (incumple RF-35). replace() y no href/assign:
      // así el botón atrás no deja atrapado en un bucle entre "/" y
      // "/{zona}/". Esto es solo la raíz: las páginas de zona y de
      // municipio ya fijan su zona desde la URL y no miran localStorage
      // para decidir dónde quedarse.
      const zonaInicial = obtenerEstado().zonaId;
      if (zonaInicial !== null) {
        location.replace(`/${zonaInicial}/`);
      } else {
        function elemento(id: string): HTMLElement {
          const el = document.getElementById(id);
          if (!el) throw new Error(`Falta el elemento #${id} en el HTML de la página.`);
          return el;
        }

        const contenedorCabecera = document.querySelector('.cabecera') as HTMLElement;
        const contenedorControlesIdentidad = elemento('controles-identidad');
        const contenedorControlesRapidos = elemento('controles-rapidos');
        const contenedorTotem = elemento('totem');
        const contenedorLista = elemento('lista');
        const contenedorMapa = elemento('mapa');
        const contenedorAvisos = elemento('avisos');
        const insigniaMock = elemento('insignia-mock');
        const hoja = elemento('hoja');
        const asaHoja = elemento('hoja-asa') as HTMLButtonElement;

        // El mapa en móvil es `position: fixed` bajo la cabecera (ADR-0006):
        // necesita saber su alto real, que puede variar si el nombre de zona
        // envuelve a una segunda línea o aparece la insignia de datos de
        // prueba. Un ResizeObserver es más fiable que adivinar un número fijo.
        const actualizarAlturaCabecera = (): void => {
          document.documentElement.style.setProperty('--cabecera-alto', `${contenedorCabecera.offsetHeight}px`);
        };
        new ResizeObserver(actualizarAlturaCabecera).observe(contenedorCabecera);
        actualizarAlturaCabecera();

        montarHoja(hoja, asaHoja, contenedorMapa);

        let indice: Indice | null = null;
        let controlesMontados = false;
        let controles: { abrirSelector: () => void } | null = null;

        // RF-43: aviso de frescura de los datos. Vive fuera del estado global
        // (src/logica/estado.ts) a propósito: es un dato derivado que solo usa
        // esta página, y el hito del mapa (H8) también toca ese fichero.
        let actualizadoZona: string | null = null;

        function horaDelDato(iso: string): string {
          const fecha = new Date(iso);
          if (Number.isNaN(fecha.getTime())) return 'hora desconocida';
          return fecha.toLocaleString('es-ES', {
            day: '2-digit',
            month: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
          });
        }

        function crearAviso(
          texto: string,
          tipo: 'error' | 'parcial' | 'desactualizado',
          conReintentar: boolean
        ): HTMLDivElement {
          const div = document.createElement('div');
          div.className = `aviso aviso--${tipo}`;
          div.append(document.createTextNode(texto));
          if (conReintentar) {
            const boton = document.createElement('button');
            boton.type = 'button';
            boton.textContent = 'Reintentar';
            boton.addEventListener('click', () => {
              cargarTodo();
            });
            div.append(boton);
          }
          return div;
        }

        function renderAvisos(estado: EstadoApp): void {
          contenedorAvisos.innerHTML = '';
          insigniaMock.hidden = !estado.mock;

          if (estado.error) {
            contenedorAvisos.append(crearAviso(estado.error, 'error', true));
            return;
          }
          if (estado.provinciasFallidas.length > 0) {
            const nombres = estado.provinciasFallidas.map((p: FalloProvincia) => p.nombre).join(', ');
            contenedorAvisos.append(
              crearAviso(
                `No se han podido cargar estos datos: ${nombres}. Se muestra el resto de la zona.`,
                'parcial',
                true
              )
            );
          }
          // RF-43: aviso discreto, no bloquea ni compite con los de arriba.
          if (actualizadoZona && datosDesactualizados(actualizadoZona, new Date())) {
            contenedorAvisos.append(
              crearAviso(`Datos de las ${horaDelDato(actualizadoZona)}. Pueden estar desactualizados.`, 'desactualizado', false)
            );
          }
        }

        // Carga (o recarga) el índice si hace falta, monta el selector de zona
        // en cuanto hay índice, y carga la zona activa. Fallo parcial de zona
        // (RF-36): un fallo de provincia no tumba las demás. Sirve también como
        // función de reintento completa desde el botón de los avisos.
        async function cargarTodo(): Promise<void> {
          actualizarEstado({ cargando: true, error: null });
          try {
            if (!indice) {
              indice = await cargarIndice();
            }
            if (!controlesMontados) {
              controles = montarControles(contenedorControlesIdentidad, contenedorControlesRapidos, indice.zonas, indice.provincias);
              controlesMontados = true;
              actualizarAlturaCabecera();
            }

            // RF-49: sin zona guardada y sin página de aterrizaje, el siguiente
            // paso es el selector, no una zona elegida por nosotros.
            const zonaGuardada = obtenerEstado().zonaId;
            if (zonaGuardada === null) {
              actualizarEstado({ cargando: false });
              controles?.abrirSelector();
              return;
            }

            // Caso imposible (no editorial, ver src/logica/zona.ts): la zona
            // guardada ya no existe en el índice porque los datos se
            // regeneraron entre medias.
            const zona = indice.zonas.find((z) => z.id === zonaGuardada) ?? zonaDeReserva(indice);
            if (zona.id !== zonaGuardada) actualizarEstado({ zonaId: zona.id });

            const resultado = await cargarZona(zona, indice.provincias);
            actualizadoZona = resultado.actualizado;
            const estacionSeleccionada = obtenerEstado().estacionId;
            const siguienteSeleccion = resultado.estaciones.some((e) => e.id === estacionSeleccionada)
              ? estacionSeleccionada
              : null;

            actualizarEstado({
              zonaNombre: zona.nombre,
              estaciones: resultado.estaciones,
              provinciasFallidas: resultado.provinciasFallidas,
              mock: resultado.mock,
              cargando: false,
              error:
                resultado.estaciones.length === 0 && resultado.provinciasFallidas.length > 0
                  ? `No se ha podido cargar ninguna provincia de ${zona.nombre}.`
                  : null,
              estacionId: siguienteSeleccion,
            });
          } catch (error) {
            actualizadoZona = null;
            actualizarEstado({
              cargando: false,
              error: error instanceof Error ? error.message : 'No se han podido cargar los datos.',
            });
          }
        }

        // Regla dura 1 de CLAUDE.md: temporizador de rescate que resuelve el
        // estado de carga pase lo que pase, aunque algo se quede colgado más
        // allá de los timeouts propios de cada petición.
        setTimeout(() => {
          if (obtenerEstado().cargando) {
            actualizarEstado({
              cargando: false,
              error: obtenerEstado().error ?? 'La carga está tardando más de lo normal. Comprueba tu conexión.',
            });
          }
        }, 12000);

        // RF-35: la URL refleja la zona para poder compartir un enlace
        // concreto (el combustible no va en la URL, vive en localStorage,
        // RF-34). Antes, un cambio de zona aquí se resolvía en sitio
        // (cargarTodo() de nuevo) y la URL se quedaba en "/" para siempre —
        // quien copiara esa URL no compartía la zona que veía, compartía la
        // portada. Ahora, igual que ya hacen las páginas de zona y municipio
        // (AppInteractiva.astro), un cambio de zona navega a su página
        // estática propia: el selector, "mi ubicación" (RF-37) y la carga
        // inicial desde localStorage acaban todos aquí.
        let zonaAnterior = obtenerEstado().zonaId;
        suscribir((estado) => {
          renderAvisos(estado);
          if (estado.zonaId !== zonaAnterior && estado.zonaId !== null) {
            zonaAnterior = estado.zonaId;
            location.href = `/${estado.zonaId}/`;
          }
        });
        renderAvisos(obtenerEstado());

        montarLista(contenedorLista);
        montarTotem(contenedorTotem);

        // RF-37: al encontrar la ubicación, se cambia a la provincia más
        // cercana (no una zona a medida: ver src/logica/zona.ts). Si el
        // índice todavía no ha llegado (pulsar el botón antes de que cargue
        // nada, poco probable pero posible), no hay nada que resolver todavía.
        function alEncontrarUbicacion(posicion: { lat: number; lon: number }): void {
          if (!indice) return;
          const provincia = provinciaMasCercana(indice, posicion);
          // ADR-0018: el id de zona de una provincia ya no se puede
          // reconstruir como `p-${id}`, hay que buscarlo en el índice.
          const zona = zonaDeProvincia(indice, provincia.id);
          if (!zona) return; // caso imposible (ver src/logica/zona.ts), no interrumpe la interfaz
          actualizarEstado({ zonaId: zona.id });
        }

        // El mapa se importa dinámicamente: MapLibre pesa bastante más que el
        // resto del bundle inicial, y RNF-11 solo cuenta el JS de antes de
        // MapLibre. Con import() dinámico, MapLibre entra en su propio chunk y
        // se descarga aparte y después, sin retrasar el primer pintado del
        // resto de la interfaz. Regla dura 2 de CLAUDE.md: si ni siquiera se
        // puede descargar ese chunk (red caída de verdad), el hueco del mapa
        // explica el fallo y el resto de la aplicación sigue intacta; Mapa.ts
        // ya gestiona por su cuenta cualquier fallo de MapLibre o de los tiles.
        import('../componentes/Mapa.ts')
          .then(({ montarMapa }) => montarMapa(contenedorMapa, alEncontrarUbicacion))
          .catch(() => {
            contenedorMapa.innerHTML = '';
            contenedorMapa.removeAttribute('style');
            const aviso = document.createElement('p');
            aviso.textContent = 'El mapa no se ha podido cargar. La lista y la ficha funcionan igual.';
            contenedorMapa.append(aviso);
          });

        cargarTodo();
      }
    </script>
  </body>
</html>
